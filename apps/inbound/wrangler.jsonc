{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "send0-inbound",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Mail arrives through Email Routing; there is no reason to expose an HTTP URL.
  "workers_dev": false,
  "preview_urls": false,
  // Raw mail goes to S3 for now. To switch to R2: create the bucket, uncomment this, set BLOB_DRIVER to "r2".
  // "r2_buckets": [{ "binding": "RAW_MAIL", "bucket_name": "send0-raw-mail" }],
  "vars": {
    // Domains this Worker accepts mail for.
    "MAIL_DOMAINS": "send0.email",
    // MTAs whose Authentication-Results we trust (topmost header only).
    "TRUSTED_AUTHSERV_IDS": "mx.cloudflare.net",
    "BLOB_DRIVER": "s3",
    "S3_BUCKET": "send0-raw-mail-aps1",
    "S3_REGION": "ap-south-1",
    // Secrets (wrangler secret put): S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
  },
  // Real-time hubs live in the API Worker; notify them as soon as a message is stored.
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub", "script_name": "send0-api" }] },
  // Webhook fan-out is consumed by the API Worker.
  "queues": { "producers": [{ "binding": "EVENTS", "queue": "send0-events" }] },
  // Postgres (Neon) through Hyperdrive; same config as the API Worker.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "d4b5efae692848d08e04fa2dd1bab031" }],
  // Run next to the database (Neon, AWS Singapore): one long hop per request instead of one per query.
  "placement": { "mode": "targeted", "region": "aws:ap-southeast-1" },
  "observability": { "enabled": true },
}
