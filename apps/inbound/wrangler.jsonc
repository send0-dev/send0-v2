{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "send0-inbound",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Mail arrives through Email Routing; there is no reason to expose an HTTP URL.
  "workers_dev": false,
  "preview_urls": false,
  // Raw mail goes to S3 for now. To switch to R2: create the bucket, uncomment this, set BLOB_DRIVER to "r2".
  // "r2_buckets": [{ "binding": "RAW_MAIL", "bucket_name": "send0-raw-mail" }],
  "vars": {
    // Domains this Worker accepts mail for.
    "MAIL_DOMAINS": "send0.email",
    // Milestone 1 has no database yet: only these local parts are accepted, everything else is rejected.
    "ALLOWED_INBOXES": "test,kunal",
    // MTAs whose Authentication-Results we trust (topmost header only).
    "TRUSTED_AUTHSERV_IDS": "mx.cloudflare.net",
    "BLOB_DRIVER": "s3",
    "S3_BUCKET": "send0-raw-mail-aps1",
    "S3_REGION": "ap-south-1"
    // Secrets (wrangler secret put): S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
  },
  "observability": { "enabled": true }
}
