{
  "$schema": "node_modules/wrangler/config-schema.json",
  // send0 in one Worker: the API, the dashboard, inbound mail, webhooks and the cron, on your own account.
  "name": "send0",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // The dashboard SPA (apps/web's build). API and dashboard routes run the Worker first; any other
  // path is a static file, or the app shell for client-side routes.
  "assets": {
    "directory": "../web/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Keep in step with WORKER_PATHS in src/http.ts.
    "run_worker_first": ["/healthz", "/v1/*", "/mcp", "/mcp/*", "/openapi.json", "/internal/*", "/health", "/auth/*", "/api/*"],
  },
  // Your Postgres (Neon's free tier works) through Hyperdrive:
  //   wrangler hyperdrive create send0-db --connection-string="postgres://..."
  // then put its id here. `wrangler dev` uses localConnectionString instead.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:send0@127.0.0.1:55432/send0_cf_dev",
    },
  ],
  // Raw mail and attachments.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "send0-blobs" }],
  // Webhook fan-out and delivery attempts, including delayed retries.
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "send0-events" }],
    "consumers": [{ "queue": "send0-events", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 10 }],
  },
  // Real-time hubs: one per inbox and one per org (SQLite-backed, available on the free plan).
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // Request limits per 60 s. namespace_id is any number unique within your Cloudflare account. If a
  // binding is missing, that rule falls back to per-isolate counters.
  "ratelimits": [
    // Keep in step with RATE_LIMITS in apps/api/src/rate-limit.ts.
    // Every request made with an API key (or by a dashboard user)
    { "name": "RL_KEY", "namespace_id": "2001", "simple": { "limit": 600, "period": 60 } },
    // On top of that, requests that send mail: send, reply, forward, approve a draft
    { "name": "RL_KEY_SEND", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
    // Per client IP: failed authentication and signed download links
    { "name": "RL_IP", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } },
  ],
  // Hourly outbox safety net and deleted-workspace purge. The queue consumer already sweeps after every
  // batch and each isolate migrates on first use, so this stays rare and lets Neon scale to zero.
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    // Domains you receive mail on (comma-separated). Route each one's catch-all to this Worker in Email Routing.
    "MAIL_DOMAINS": "agents.example.com",
    // The region of your verified SES identity.
    "SES_REGION": "us-east-1",
    // Only OWNER_EMAIL can create the first account; everyone else joins by invite.
    "ALLOW_SIGNUP": "false",
    // Optional: forward postmaster@ and abuse@ on your mail domains to this address instead of refusing
    // them. It must be a verified destination address under Email Routing > Destination addresses.
    // "OPERATOR_FORWARD_TO": "you@example.com",
    // Secrets (wrangler secret put, or the Deploy button's prompts): see .dev.vars.example.
  },
  "observability": { "enabled": true },
}
