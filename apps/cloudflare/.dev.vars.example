# Settings the Deploy to Cloudflare button asks for. For `wrangler dev`, copy this to .dev.vars
# (values there override wrangler.jsonc's vars). Never commit .dev.vars.

# Signs download links. At least 32 characters: openssl rand -hex 32
SECRET_KEY=

# The email of the first account, who becomes the owner. Sign-up is closed to everyone else.
OWNER_EMAIL=

# Domains you receive mail on, comma-separated, like agents.acme.com. The first is the default for new inboxes.
MAIL_DOMAINS=

# Required: an IAM user allowed ses:SendRawEmail for your verified SES identity. send0 sends the owner's
# verification email and all outbound mail through SES. Set SES_REGION (a var) to that identity's region.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Sender of verification, password-reset and invite email. Defaults to noreply@<first mail domain>.
MAIL_FROM=

# Optional. The one URL people and SDKs use, like https://mail.acme.com. Set it if you add a custom
# domain: requests to any other hostname (such as workers.dev) are redirected there. Unset, each
# request's own origin is used.
PUBLIC_URL=
