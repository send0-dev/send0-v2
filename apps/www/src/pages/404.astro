---
import Base from "../layouts/Base.astro";
import Guides from "../components/Guides.astro";
import Ticks from "../components/Ticks.astro";
---

<Base title="Page not found" noindex sheet="404">
  <div class="page">
    <Guides />
    <div class="wrap">
      <section class="nf">
        <div class="head">
          <div class="eyebrow">
            # 404 <i>[return to sender]</i>
          </div>
          <h1>No such address.</h1>
          <p class="lede">This page bounced. It may have moved, or the link was mistyped.</p>
        </div>
        <div class="term">
          <div class="bar">
            <span>smtp</span>
            <span>550 5.1.1</span>
          </div>
          <pre><span class="p">&gt;</span> RCPT TO:&lt;this-page@send0.dev&gt;
<span class="p">&lt;</span> 550 5.1.1 No such address here</pre>
        </div>
        <div class="actions">
          <a class="btn solid" href="/">
            Back to send0
          </a>
          <a class="btn" href="/docs">
            Read the docs
          </a>
        </div>
        <Ticks />
      </section>
    </div>
  </div>
</Base>

<style>
  .nf {
    display: grid;
    gap: 32px;
    min-height: 62vh;
    align-content: center;
  }
  .term {
    max-width: 560px;
  }
  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
</style>
