---
import Base from "../layouts/Base.astro";
import Envelope from "../illustrations/Envelope.astro";
---

<Base title="Page not found" noindex>
  <section class="section">
    <div class="wrap nf">
      <Envelope class="env" />
      <p class="code mono">550 5.1.1 · Return to sender</p>
      <h1>
        No such <em>address.</em>
      </h1>
      <p class="msg">This page bounced. It may have moved, or the link was mistyped.</p>
      <a class="btn btn-primary" href="/">
        Back to send0
      </a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 56vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .nf :global(.env) {
    width: 200px;
    margin-bottom: 28px;
    transform: rotate(-6deg);
  }
  .code {
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--postal-ink);
  }
  h1 {
    margin-top: 14px;
    font-size: clamp(42px, 7vw, 68px);
    font-weight: 400;
  }
  h1 em {
    color: var(--postal-ink);
  }
  .msg {
    max-width: 440px;
    margin: 16px 0 32px;
    color: var(--muted);
    font-size: 17px;
  }
</style>
