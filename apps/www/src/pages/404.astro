---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" noindex>
  <div class="column">
    <section class="section nf">
      <p class="code mono">550 5.1.1</p>
      <h1>No such address.</h1>
      <p class="msg">This page bounced. It may have moved, or the link was mistyped. The inbox you're looking for is probably back home.</p>
      <a class="btn btn-primary" href="/">
        Back to send0
      </a>
    </section>
  </div>
</Base>

<style>
  .nf {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .code {
    font-size: 13px;
    color: var(--accent-ink);
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
  }
  h1 {
    margin-top: 24px;
    font-size: clamp(40px, 7vw, 64px);
    letter-spacing: -0.045em;
  }
  .msg {
    max-width: 440px;
    margin: 18px 0 32px;
    color: var(--fg-muted);
    font-size: 17px;
  }
</style>
