---
// Small line icons, one per capability.
interface Props {
  name: "inbox" | "wait" | "thread" | "live" | "key" | "shield";
  class?: string;
}
const { name, class: cls } = Astro.props;
---

<svg
  data-draw
  class:list={["ill", "glyph", cls]}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "inbox" && (
    <>
      <path
        pathLength="1"
        d="M7.5 27.5 13.6 11.4c.4-1 1-1.4 2-1.4h16.8c1 0 1.6.4 2 1.4l6.2 16.1V37c0 1.4-.6 2-2 2h-29c-1.4 0-2-.6-2-2Z"
        fill="var(--card)"
      />
      <path pathLength="1" d="M7.6 27.5h9.6l2.4 4.6h8.8l2.4-4.6h9.6" />
      <path pathLength="1" d="M24 13.5v9M20 19l4 4 4-4" stroke="var(--accent)" />
    </>
  )}
  {name === "wait" && (
    <>
      <path pathLength="1" d="M14 7.5h20M14 40.5h20" />
      <path pathLength="1" d="M16.5 8c0 9 15 11 15 16s-15 7-15 16M31.5 8c0 9-15 11-15 16s15 7 15 16" fill="var(--card)" />
      <path d="M19.5 38c1.6-4 7.4-4 9 0Z" fill="var(--accent-bg)" stroke="none" />
      <path pathLength="1" d="M21.5 15.5h5" stroke="var(--accent)" />
    </>
  )}
  {name === "thread" && (
    <>
      <path pathLength="1" d="M10 38.5 34.4 14" stroke-width="2.4" />
      <ellipse pathLength="1" cx="36.6" cy="11.8" rx="2" ry="3.6" transform="rotate(45 36.6 11.8)" fill="var(--card)" />
      <path pathLength="1" d="M36 12.5c8 4 4 14-3 15s-12 3-11 8 7 4 8 1" stroke="var(--accent)" />
    </>
  )}
  {name === "live" && (
    <>
      <circle pathLength="1" cx="24" cy="26" r="3.6" fill="var(--accent-bg)" />
      <path
        pathLength="1"
        d="M17 19.5a10 10 0 0 0 0 13M31 19.5a10 10 0 0 1 0 13M11.5 14a17.6 17.6 0 0 0 0 24M36.5 14a17.6 17.6 0 0 1 0 24"
      />
      <path pathLength="1" d="M24 30v11" />
    </>
  )}
  {name === "key" && (
    <>
      <circle pathLength="1" cx="16" cy="18" r="8.6" fill="var(--card)" />
      <circle pathLength="1" cx="16" cy="18" r="2.6" />
      <path pathLength="1" d="m22.4 23.8 15 15M30.6 32l4-4M34.4 35.8l3.2-3.2" />
    </>
  )}
  {name === "shield" && (
    <>
      <path
        pathLength="1"
        d="M24 6.5c4.6 2.6 9.2 4 14 4.4.4 13.8-3.4 24.6-14 30.6-10.6-6-14.4-16.8-14-30.6 4.8-.4 9.4-1.8 14-4.4Z"
        fill="var(--card)"
      />
      <path pathLength="1" d="m18 24 4.4 4.4L30.6 19" stroke="var(--ok)" stroke-width="2.2" />
    </>
  )}
</svg>
