---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Guides from "../components/Guides.astro";
import { site } from "../site";
import { getRepoInfo } from "../lib/github";
import martianUrl from "@fontsource-variable/martian-mono/files/martian-mono-latin-standard-normal.woff2?url";
import hostUrl from "@fontsource-variable/host-grotesk/files/host-grotesk-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** The page's name in the left margin label, as on a drawing's title block. */
  sheet?: string;
}

const { title, description = site.description, noindex = false, sheet = "home" } = Astro.props;
const fullTitle = title ? `${title} · send0` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL("/og.png", site.url).href;
const { version } = await getRepoInfo();

// Latin subsets only. The fallbacks are metric-matched so the swap doesn't shift layout.
const latin =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2190-2193,U+2212,U+2215,U+2713,U+FEFF,U+FFFD";
const fontCss = `
@font-face{font-family:"Martian Mono";font-style:normal;font-weight:100 800;font-stretch:75% 112.5%;font-display:swap;src:url(${martianUrl}) format("woff2");unicode-range:${latin}}
@font-face{font-family:"Host Grotesk";font-style:normal;font-weight:300 800;font-display:swap;src:url(${hostUrl}) format("woff2");unicode-range:${latin}}
@font-face{font-family:"Martian Mono Fallback";src:local("Courier New"),local("CourierNewPSMT");ascent-override:85.76%;descent-override:17.15%;line-gap-override:0%;size-adjust:116.6%}
@font-face{font-family:"Martian Mono Narrow Fallback";src:local("Courier New"),local("CourierNewPSMT");ascent-override:92.08%;descent-override:18.42%;line-gap-override:0%;size-adjust:108.6%}
@font-face{font-family:"Host Grotesk Fallback";src:local("Arial"),local("ArialMT");ascent-override:96.07%;descent-override:29.81%;line-gap-override:0%;size-adjust:105.66%}
`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "send0",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  description: site.description,
  url: site.url,
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#FBFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121116" media="(prefers-color-scheme: dark)" />

    <link rel="preload" href={martianUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={hostUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="send0" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Before first paint, so a saved theme never flashes. -->
    <script is:inline>
      (function () {
        try {
          var t = new URLSearchParams(location.search).get("theme") || localStorage.getItem("send0-theme");
          if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <span class="margin-label l" aria-hidden="true">
      send0 · {sheet} · {version}
    </span>
    <span class="margin-label r" aria-hidden="true">
      open source · agpl-3.0
    </span>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <div class="page">
      <Guides />
      <Footer />
    </div>
  </body>
</html>
