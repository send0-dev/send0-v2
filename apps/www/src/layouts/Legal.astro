---
import Base from "./Base.astro";
import Guides from "../components/Guides.astro";
import Ticks from "../components/Ticks.astro";
import { site } from "../site";

interface Props {
  title: string;
  description: string;
  summary: string;
}

const { title, description, summary } = Astro.props;

const pages = [
  { href: "/terms", label: "Terms of Service", sheet: "terms" },
  { href: "/privacy", label: "Privacy Policy", sheet: "privacy" },
  { href: "/acceptable-use", label: "Acceptable Use Policy", sheet: "acceptable use" },
];
const path = Astro.url.pathname.replace(/\.html$/, "");
const current = pages.find((p) => p.href === path);
---

<Base title={title} description={description} sheet={current?.sheet ?? "legal"}>
  <div class="page">
    <Guides />
    <div class="wrap">
      <section class="legal-head">
        <div class="head">
          <div class="eyebrow">
            # Legal <i>[updated {site.legalUpdated.toLowerCase()}]</i>
          </div>
          <h1>{title}</h1>
        </div>
        <div class="summary">
          <div class="fig-cap">
            <span>[ in short ]</span>
          </div>
          <p>{summary}</p>
        </div>
        <Ticks />
      </section>
      <section class="legal-body">
        <nav class="side" aria-label="Legal pages">
          {pages.map((p, i) => (
            <a href={p.href} aria-current={path === p.href ? "page" : undefined}>
              <span class="n">{String(i + 1).padStart(2, "0")}</span>
              {p.label}
            </a>
          ))}
        </nav>
        <article class="prose">
          <slot />
        </article>
      </section>
    </div>
  </div>
</Base>

<style>
  .legal-head {
    padding-bottom: clamp(40px, 6vw, 64px);
  }
  h1 {
    font-size: clamp(36px, 5vw, 60px);
  }
  .summary {
    margin-top: 32px;
    max-width: 760px;
    padding: 18px 20px;
    border: 1px solid var(--ink);
    background: var(--acc-soft);
  }
  .summary .fig-cap {
    margin-bottom: 8px;
    color: var(--acc-text);
  }
  .summary p {
    margin: 0;
    font: 14px/1.7 var(--mono);
  }
  .legal-body {
    display: grid;
    gap: 40px;
    border-bottom: 0;
    padding-top: clamp(40px, 6vw, 64px);
  }
  @media (min-width: 900px) {
    .legal-body {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 64px;
    }
    .side {
      position: sticky;
      top: calc(var(--top) + 24px);
      align-self: start;
    }
  }
  .side {
    display: grid;
    border: 1px solid var(--line-2);
    align-self: start;
    background: var(--paper);
  }
  .side a {
    display: grid;
    grid-template-columns: 28px 1fr;
    padding: 14px 16px;
    font: 500 12.5px var(--mono);
    text-decoration: none;
    border-bottom: 1px solid var(--line-2);
  }
  .side a:last-child {
    border-bottom: 0;
  }
  .side a:hover {
    color: var(--acc-text);
  }
  .side .n {
    color: var(--muted);
  }
  .side a[aria-current="page"] {
    background: var(--acc-soft);
  }
  .side a[aria-current="page"] .n {
    color: var(--acc-text);
  }
  .prose {
    max-width: 720px;
    font-size: 16.5px;
    line-height: 1.75;
    background: var(--paper);
  }
  .prose :global(h2) {
    margin: 52px 0 14px;
    font-size: 24px;
    letter-spacing: -0.04em;
    font-variation-settings: "wdth" 88;
    scroll-margin-top: calc(var(--top) + 24px);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    margin: 30px 0 10px;
    font-size: 18px;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 16px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 22px;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(li::marker) {
    color: var(--acc-text);
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-2);
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--acc-text);
  }
  .prose :global(.table-scroll) {
    overflow-x: auto;
    margin: 0 0 20px;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px 12px;
    border: 1px solid var(--line-2);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    font: 500 11px var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
