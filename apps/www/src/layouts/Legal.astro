---
import Base from "./Base.astro";
import { site } from "../site";

interface Props {
  title: string;
  description: string;
  summary: string;
}

const { title, description, summary } = Astro.props;

const pages = [
  { href: "/terms", label: "Terms of Service" },
  { href: "/privacy", label: "Privacy Policy" },
  { href: "/acceptable-use", label: "Acceptable Use Policy" },
];
const path = Astro.url.pathname.replace(/\.html$/, "");
---

<Base title={title} description={description}>
  <section class="section legal">
    <div class="wrap">
      <header class="head">
        <span class="eyebrow">Legal</span>
        <h1>{title}</h1>
        <p class="updated mono">Last updated {site.legalUpdated}</p>
        <p class="summary">
          <span class="mono tag">In short</span>
          {summary}
        </p>
      </header>

      <div class="layout">
        <nav class="side" aria-label="Legal pages">
          {pages.map((p) => (
            <a href={p.href} aria-current={path === p.href ? "page" : undefined}>
              {p.label}
            </a>
          ))}
        </nav>
        <article class="prose">
          <slot />
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    max-width: 760px;
    margin-bottom: 56px;
  }
  h1 {
    font-size: clamp(38px, 5vw, 56px);
    font-weight: 400;
  }
  .updated {
    margin-top: 14px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .summary {
    margin-top: 28px;
    padding: 20px 22px;
    background: var(--card);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--postal);
    border-radius: 4px 10px 10px 4px;
    box-shadow: var(--shadow-sm);
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink);
  }
  .tag {
    display: block;
    margin-bottom: 6px;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--postal-ink);
  }
  .layout {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 72px;
    }
    .side {
      position: sticky;
      top: 100px;
      align-self: start;
      flex-direction: column;
    }
  }
  .side {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .side a {
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 14.5px;
    color: var(--muted);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .side a:hover {
    background: var(--paper-alt);
    color: var(--ink);
  }
  .side a[aria-current="page"] {
    background: var(--card);
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 2px 0 0 var(--postal);
  }
  .prose {
    max-width: 700px;
    font-size: 16.5px;
    line-height: 1.75;
    color: color-mix(in srgb, var(--ink) 80%, transparent);
  }
  .prose :global(h2) {
    margin: 52px 0 14px;
    font-size: 26px;
    font-weight: 450;
    color: var(--ink);
    scroll-margin-top: 90px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    margin: 30px 0 10px;
    font-size: 19px;
    font-weight: 500;
    color: var(--ink);
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 16px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 22px;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(li::marker) {
    color: var(--postal-ink);
  }
  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--rule);
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--postal);
  }
  .prose :global(table) {
    width: 100%;
    margin: 0 0 20px;
    border-collapse: collapse;
    font-size: 14.5px;
    background: var(--card);
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px 12px;
    border: 1px solid var(--hairline);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    background: var(--paper-alt);
    color: var(--ink);
    font-weight: 600;
  }
  .prose :global(.table-scroll) {
    overflow-x: auto;
  }
</style>
