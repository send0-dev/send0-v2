---
import Stamp from "../components/Stamp.astro";
import StampGlyph from "../illustrations/StampGlyph.astro";

const stamps = [
  {
    glyph: "inbox",
    tint: "butter",
    title: "One call, one inbox",
    body: "<code>POST /v1/inboxes</code> returns an address.",
  },
  {
    glyph: "wait",
    tint: "sky",
    title: "Wait, don't poll",
    body: "Returns when matching mail lands.",
  },
  {
    glyph: "thread",
    tint: "sage",
    title: "Threads that hold",
    body: "Headers first, then subject and people.",
  },
  {
    glyph: "live",
    tint: "sage",
    title: "Webhooks and events",
    body: "Signed, retried for about a day. SSE too.",
  },
  {
    glyph: "key",
    tint: "butter",
    title: "Keys for one inbox",
    body: "Scope API keys to specific inboxes.",
  },
  {
    glyph: "shield",
    tint: "sky",
    title: "Untrusted by default",
    body: "SPF, DKIM, DMARC and injection flags.",
  },
] as const;
---

<section class="section band" id="features" aria-labelledby="stamps-title">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">
        <b>02</b> The essentials
      </span>
      <h2 id="stamps-title" class="h2">
        Six things every agent inbox needs.
      </h2>
    </div>

    <ul class="sheet">
      {stamps.map((s, i) => (
        <li data-reveal="stamp" style={`--d:${i * 0.09}s`}>
          <Stamp tint={s.tint}>
            <StampGlyph name={s.glyph} class="glyph" />
            <h3>{s.title}</h3>
            <p set:html={s.body} />
          </Stamp>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head {
    margin-bottom: 48px;
  }
  .h2 {
    max-width: 15em;
  }
  .sheet {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }
  @media (min-width: 640px) {
    .sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .sheet {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 26px 28px;
    }
  }
  .sheet li {
    display: grid;
  }
  .sheet li :global(.stamp-wrap:hover) {
    transform: rotate(-1deg) translateY(-3px);
  }
  .sheet :global(.glyph) {
    width: 46px;
    height: 46px;
    margin: -4px 0 14px -4px;
  }
  h3 {
    font-size: 22px;
    line-height: 1.15;
  }
  p {
    margin-top: 8px;
    font-size: 14.5px;
    line-height: 1.55;
    color: color-mix(in srgb, var(--ink) 78%, transparent);
  }
</style>
