---
import Postcard from "../components/Postcard.astro";
import RobotHand from "../illustrations/RobotHand.astro";
import StringThread from "../illustrations/StringThread.astro";
import RubberStamp from "../illustrations/RubberStamp.astro";
---

<section class="section" id="use-cases" aria-labelledby="cando-title">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">
        <b>01</b> What your agent can do
      </span>
      <h2 id="cando-title" class="h2">
        The world still asks by email.
      </h2>
    </div>

    <div class="cards">
      <Postcard tint="butter" tilt={-1.2} delay={0} stacked>
        <RobotHand slot="picture" class="pic" />
        <h3>Sign up and verify</h3>
        <p>
          It signs up, then <code>wait</code> returns the code.
        </p>
        <span class="line mono">
          msg.extracted.otp <span class="c">// "482913"</span>
        </span>
      </Postcard>

      <Postcard tint="sky" tilt={0.8} delay={0.12} stacked class="drop">
        <StringThread slot="picture" class="pic" />
        <h3>Hold a conversation</h3>
        <p>Replies match by Message-ID, so threads hold.</p>
        <span class="line mono">
          thread.messages <span class="c">// 3, in order</span>
        </span>
      </Postcard>

      <Postcard tint="sage" tilt={-0.6} delay={0.24} stacked>
        <RubberStamp slot="picture" class="pic" />
        <h3>Keep a person in the loop</h3>
        <p>Outgoing mail waits as a draft for approval.</p>
        <span class="line mono">
          send_policy: <span class="s">"approval"</span>
        </span>
      </Postcard>
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: 52px;
  }
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }
  @media (max-width: 899px) {
    .cards {
      max-width: 520px;
    }
  }
  @media (min-width: 900px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
      align-items: start;
    }
    /* hand-placed: the middle card sits a little lower */
    .cards :global(.drop) {
      margin-top: 36px;
    }
  }
  .cards :global(.pic) {
    width: 100%;
    max-width: 168px;
    max-height: 140px;
  }
  h3 {
    font-size: 22px;
    padding-right: 48px;
  }
  .cards p {
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
  }
  .line {
    display: inline-block;
    margin-top: 14px;
    padding-top: 9px;
    border-top: 1.5px dashed var(--hairline);
    font-size: 12.5px;
    color: var(--ink);
  }
  .c {
    color: var(--muted);
  }
  .s {
    color: var(--accent);
  }
</style>
