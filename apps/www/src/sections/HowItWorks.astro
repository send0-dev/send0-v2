---
// Four steps; the selected one drives the code figure beside it. A vertical tablist, so arrow keys move between steps.
const steps = [
  {
    title: "Create an inbox",
    body: "A real address on send0.email. One POST.",
    code: `<span class="k">const</span> inbox = <span class="k">await</span> send0.inboxes.create({
  name: <span class="s">"signup-agent"</span>,
});
inbox.address <span class="c">// "signup-agent@send0.email"</span>`,
  },
  {
    title: "Wait, don't poll",
    body: "wait() returns the moment matching mail lands, code and link already extracted.",
    code: `<span class="k">const</span> msg = <span class="k">await</span> send0.inboxes.wait(inbox.id, {
  from: <span class="s">"*@github.com"</span>, timeout: 60,
});
msg.extracted.otp          <span class="c">// "482913"</span>
msg.extracted.action_link  <span class="c">// "https://github.com/…"</span>`,
  },
  {
    title: "Reply in the thread",
    body: "In-Reply-To and References set for you, so Gmail and Outlook keep one conversation.",
    code: `<span class="k">await</span> send0.messages.reply(msg.id, {
  text: <span class="s">"Thursday at 3 works."</span>,
});
<span class="c">// In-Reply-To and References set,
// subject kept: same thread everywhere</span>`,
  },
  {
    title: "Get pinged",
    body: "Signed webhooks on every plan, plus a live event stream.",
    code: `POST https://you.dev/hooks
send0-signature: t=1760000000,v1=5f3a…

{ <span class="k">"type"</span>: <span class="s">"message.received"</span>,
  <span class="k">"data"</span>: { <span class="k">"id"</span>: "msg_8f2k", <span class="k">"thread_id"</span>: "thr_3Lp8" } }`,
  },
];
---

<section id="how" aria-labelledby="how-title">
  <div class="head">
    <div class="eyebrow">
      # How it works <i aria-hidden="true">[...]</i>
    </div>
    <h2 id="how-title">From SMTP to your agent in one call</h2>
    <p class="lede">Create an inbox, wait for mail, reply in the thread. send0 handles the parts of email nobody wants to build.</p>
  </div>
  <div class="split">
    <div class="items" role="tablist" aria-label="Steps" aria-orientation="vertical" data-tabs>
      {steps.map((s, i) => (
        <button
          class="item"
          type="button"
          role="tab"
          id={`step-${i}`}
          aria-controls={`step-panel-${i}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="n">{String(i + 1).padStart(2, "0")}</span>
          <span>
            <span class="h3">{s.title}</span>
            <span class="d">{s.body}</span>
          </span>
        </button>
      ))}
    </div>
    <div class="show stack">
      {steps.map((s, i) => (
        <pre id={`step-panel-${i}`} role="tabpanel" aria-labelledby={`step-${i}`} tabindex="0" hidden={i !== 0} set:html={s.code} />
      ))}
    </div>
  </div>
</section>

<script>
  import "../scripts/tabs";
</script>
