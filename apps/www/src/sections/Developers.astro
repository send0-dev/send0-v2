---
// fig. 2: the same flow in each SDK and over MCP. Tool names match packages/agent-tools.
const files = [
  {
    id: "ts",
    label: "typescript",
    code: `<span class="k">import</span> { Send0 } <span class="k">from</span> <span class="s">"@send0/sdk"</span>;

<span class="k">const</span> send0 = <span class="k">new</span> Send0(); <span class="c">// reads SEND0_API_KEY</span>
<span class="k">const</span> inbox = <span class="k">await</span> send0.inboxes.create({ name: <span class="s">"signup-agent"</span> });

<span class="k">const</span> msg = <span class="k">await</span> send0.inboxes.wait(inbox.id, { from: <span class="s">"*@github.com"</span> });
console.log(msg.extracted.otp); <span class="c">// "482913"</span>

<span class="k">await</span> send0.messages.reply(msg.id, { text: <span class="s">"Thanks, confirmed."</span> });`,
  },
  {
    id: "py",
    label: "python",
    code: `<span class="k">from</span> send0 <span class="k">import</span> Send0

send0 = Send0()  <span class="c"># reads SEND0_API_KEY</span>
inbox = send0.inboxes.create(name=<span class="s">"signup-agent"</span>)

msg = send0.inboxes.wait(inbox.id, from_=<span class="s">"*@github.com"</span>)
print(msg.extracted.otp)  <span class="c"># "482913"</span>

send0.messages.reply(msg.id, text=<span class="s">"Thanks, confirmed."</span>)`,
  },
  {
    id: "mcp",
    label: "mcp",
    code: `<span class="c"># Claude Code, Cursor, any MCP client</span>
claude mcp add send0 --env SEND0_API_KEY=s0_live_… \\
  -- npx -y @send0/mcp

<span class="c"># tools</span>
create_inbox · wait_for_email · reply · send_email
search_messages · get_thread · list_threads`,
  },
].map((f) => ({
  ...f,
  lines: f.code
    .split("\n")
    .map((_, i) => i + 1)
    .join("\n"),
}));
---

<section id="dev" aria-labelledby="dev-title">
  <div class="head">
    <div class="eyebrow">
      # Developers <i aria-hidden="true">[api · sdk · mcp]</i>
    </div>
    <h2 id="dev-title">One API, four ways in</h2>
    <p class="lede">
      TypeScript and Python SDKs, an MCP server for Claude and Cursor, tools for the Vercel AI SDK and LangChain, or plain HTTP.
    </p>
  </div>
  <div class="fig">
    <div class="fig-bar" aria-hidden="true">
      <span class="sq">‹›</span>
      <span>[ fig. 2 — agent.ts ]</span>
      <span class="sq">⊞</span>
    </div>
    <div class="tabs" role="tablist" aria-label="Language" data-tabs>
      {files.map((f, i) => (
        <button
          class="tab"
          type="button"
          role="tab"
          id={`code-${f.id}`}
          aria-controls={`code-panel-${f.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          {f.label}
        </button>
      ))}
    </div>
    <div class="codes">
      {files.map((f, i) => (
        <div class="code" id={`code-panel-${f.id}`} role="tabpanel" aria-labelledby={`code-${f.id}`} tabindex="0" hidden={i !== 0}>
          <div class="ln" aria-hidden="true">
            {f.lines}
          </div>
          <pre set:html={f.code} />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import "../scripts/tabs";
</script>
