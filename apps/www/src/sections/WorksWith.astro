---
// Luggage tags for the clients send0 already plugs into. Add LangChain / Vercel AI SDK once they ship.
const tags = [
  { name: "Claude", how: "MCP" },
  { name: "Claude Code", how: "MCP" },
  { name: "Cursor", how: "MCP" },
  { name: "VS Code", how: "MCP" },
  { name: "TypeScript", how: "SDK" },
  { name: "Python", how: "SDK" },
  { name: "Any HTTP client", how: "REST" },
];
---

<section class="works" aria-labelledby="works-title">
  <div class="wrap inner">
    <h2 id="works-title" class="mono">
      Plugs into
    </h2>
    <ul>
      {tags.map((t, i) => (
        <li class="tag" style={`--tilt:${[-1.5, 1, -0.5, 1.5, -1, 0.5, -1.2][i]}deg`}>
          <span class="hole" aria-hidden="true" />
          <span class="name">{t.name}</span>
          <span class="how mono">{t.how}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .works {
    padding-block: 26px;
    border-bottom: 1px solid var(--hairline);
    background: var(--paper-alt);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }
  h2 {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 14px;
  }
  /* a luggage tag: a stub with a punched hole, then the name */
  .tag {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 38px;
    padding: 0 14px 0 34px;
    background: var(--card);
    border: 1.5px solid var(--ink);
    border-radius: 12px 7px 7px 12px;
    transform: rotate(var(--tilt));
  }
  .tag::after {
    content: "";
    position: absolute;
    left: 24px;
    top: 5px;
    bottom: 5px;
    border-left: 1.5px dashed var(--rule);
  }
  .hole {
    position: absolute;
    left: 8px;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    background: var(--paper-alt);
  }
  .name {
    font-weight: 550;
    font-size: 14.5px;
  }
  .how {
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
</style>
