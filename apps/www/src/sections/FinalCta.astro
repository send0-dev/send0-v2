---
import AddressLabel from "../components/AddressLabel.astro";
import EnvelopeOpen from "../illustrations/EnvelopeOpen.astro";
import Doodle from "../components/Doodle.astro";
import { site } from "../site";
---

<section class="section final" id="waitlist" aria-labelledby="final-title">
  <div class="wrap">
    <div class="envelope">
      <div class="art">
        <EnvelopeOpen class="ill-big" />
      </div>
      <div class="copy">
        <h2 id="final-title" class="h2">
          Your agent's inbox is <Doodle kind="ring">one API call</Doodle> away.
        </h2>
        <p class="lede">
          One email at launch. Or{" "}
          <a class="link" href={site.docs.selfHost}>
            self-host today
          </a>
          .
        </p>
        <div class="form">
          <AddressLabel source="footer-cta" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .envelope {
    position: relative;
    display: grid;
    gap: 32px;
    padding: 40px 24px;
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: 16px;
  }
  @media (min-width: 900px) {
    .envelope {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
      align-items: center;
      gap: 56px;
      padding: 64px 72px;
    }
  }
  .art {
    display: grid;
    place-items: center;
  }
  .art :global(.ill-big) {
    width: 100%;
    max-width: min(320px, 70%);
  }
  .h2 {
    max-width: 13em;
  }
  .lede :global(.link) {
    white-space: nowrap;
  }
  .form {
    margin-top: 28px;
  }
</style>
