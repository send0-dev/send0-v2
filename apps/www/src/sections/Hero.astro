---
import AddressLabel from "../components/AddressLabel.astro";
import Postmark from "../components/Postmark.astro";
import HeroDemo from "../components/HeroDemo.astro";
import Doodle from "../components/Doodle.astro";
import { getRepoInfo } from "../lib/github";

const repo = await getRepoInfo();
---

<section class="hero">
  <div class="wrap grid">
    <div class="copy">
      <a class="release mono" href={repo.releaseUrl} rel="noopener">
        <span class="dot" aria-hidden="true"></span>
        Self-host {repo.version} is out
        <span aria-hidden="true">→</span>
      </a>
      <h1>
        Give your agent{" "}
        <span class="nb">
          an <Doodle>email address.</Doodle>
        </span>
      </h1>
      <p class="sub">
        One API call gives your agent a real inbox. It receives mail, replies in the same thread, and tells your code the moment something
        lands.
      </p>
      <div class="form">
        <AddressLabel source="hero" />
        <a class="docs link" href="/docs">
          Or read the docs first
        </a>
      </div>
      <ul class="marks" aria-label="Licences and hosting">
        <li>
          <Postmark title="Open source" detail="AGPL-3.0 server" tone="blue" />
        </li>
        <li>
          <Postmark title="SDKs and MCP" detail="MIT licensed" />
        </li>
        <li>
          <Postmark title="Self-host" detail="Docker or Cloudflare" />
        </li>
      </ul>
    </div>
    <div class="stage">
      <HeroDemo />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 48px 72px;
  }
  @media (min-width: 768px) {
    .hero {
      padding-block: 52px 80px;
    }
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 56px;
  }
  @media (min-width: 1180px) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6.4fr);
      gap: 56px;
      align-items: center;
    }
  }
  .copy {
    max-width: 600px;
  }
  .release {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 10px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 12.5px;
    color: var(--muted);
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .release:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-bg);
  }
  h1 {
    margin-top: 24px;
    font-size: clamp(42px, 4.7vw, 64px);
    font-weight: 650;
    line-height: 1.02;
    letter-spacing: -0.022em;
    text-wrap: initial;
  }
  .nb {
    white-space: nowrap;
  }
  .sub {
    margin-top: 22px;
    max-width: 30em;
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.55;
    color: var(--muted);
  }
  .form {
    margin-top: 30px;
  }
  .docs {
    display: inline-block;
    margin-top: 12px;
    margin-left: 4px;
    font-size: 14.5px;
  }
  .marks {
    list-style: none;
    margin: 28px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-wrap: wrap;
    gap: 14px 20px;
  }
  .stage {
    min-width: 0;
  }
</style>
