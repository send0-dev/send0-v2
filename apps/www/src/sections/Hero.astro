---
import Ticks from "../components/Ticks.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import { site } from "../site";
import { getRepoInfo } from "../lib/github";

const { version, releaseUrl } = await getRepoInfo();

// fig. 1 is sample data: made-up agent names and example senders, no real accounts.
const names = ["signup-agent", "support-ai", "billing-bot", "qa-runner", "research-agent", "sched-bot", "ops-agent", "onboard-ai"];
const events: [string, string[]][] = [
  ["noreply@github.com", ["otp 482913"]],
  ["invoices@stripe.com", ["link", "pdf"]],
  ["dana@acme.com", ["thread", "replied"]],
  ["no-reply@vercel.com", ["otp 771204"]],
  ["alex@northwind.io", ["thread"]],
  ["hello@linear.app", ["link"]],
];

// 168 inboxes on desktop; CSS shows the first 98 on phones. A few are mid-flight so the still frame reads as live.
const CELLS = 168;
const on = new Set([27, 61, 90, 140]);
const open = new Set([8, 47, 76, 118, 153]);
const cells = Array.from({ length: CELLS }, (_, i) =>
  ["cell", i % 13 === 5 && "hatch", on.has(i) && "on", open.has(i) && "open"].filter(Boolean).join(" "),
);

// The still frame's log, newest first, about one event per tick.
const pad = (n: number) => String(n).padStart(2, "0");
const rows = Array.from({ length: 6 }, (_, i) => {
  const s = 41 * 60 + 52 - i * 2 - (i > 2 ? 1 : 0);
  const [from, tags] = events[(i * 5 + 2) % events.length]!;
  return { t: `14:${pad(Math.floor(s / 60))}:${pad(s % 60)}`, to: names[(i * 3 + 1) % names.length]!, from, tags };
});
---

<section class="hero">
  <div class="copy">
    <a class="status" href={releaseUrl}>
      <i aria-hidden="true"></i>
      {version} · SDKs on npm and PyPI →
    </a>
    <h1>Email infrastructure for AI agents</h1>
    <p class="lede">
      One API call gives your agent a real inbox. It receives mail, replies in the same thread, and calls your code the moment something
      arrives. Open source, self-hostable, webhooks on every plan.
    </p>
    <div class="ctas" id="join">
      <WaitlistForm />
      <a class="btn" href={site.docs.home}>
        Read the docs
      </a>
      <span class="fine">
        or self-host today: <b>docker compose up</b>
      </span>
    </div>
  </div>

  <div
    class="fig"
    role="img"
    aria-label="Figure 1: a grid of agent inboxes. Mail lands in one, its agent replies, and each event is logged."
  >
    <div class="fig-bar">
      <span class="sq">‹›</span>
      <span>[ fig. 1 — agent inboxes ]</span>
      <span class="sq">⊞</span>
    </div>
    <div class="fig-in">
      <div class="f1">
        <div class="fig-card">
          <div class="fig-cap">
            <span>[ fig. 1a · inboxes ]</span>
            <span>
              <span class="n-lg">168</span>
              <span class="n-sm">98</span> inboxes · sample
            </span>
          </div>
          <div class="grid" id="f1-grid">
            {cells.map((c) => (
              <i class={c}></i>
            ))}
          </div>
          <div class="legend">
            <span>
              <i></i>idle
            </span>
            <span>
              <i class="a"></i>mail arrived
            </span>
            <span>
              <i class="o"></i>agent replying
            </span>
          </div>
        </div>
        <div class="fig-card">
          <div class="fig-cap">
            <span>[ fig. 1b · events ]</span>
            <span>message.received</span>
          </div>
          <div class="log" id="f1-log" data-names={JSON.stringify(names)} data-events={JSON.stringify(events)}>
            {rows.map((r) => (
              <div class="row">
                <span class="t">{r.t}</span>
                <span class="what">
                  <b>{r.to}@</b> ← {r.from}
                  <br />
                  {r.tags.map((t, i) => (
                    <span class={i === 0 ? "tag a" : "tag"}>{t}</span>
                  ))}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
  <Ticks />
</section>

<script>
  // fig. 1: mail lands in a random inbox, the agent replies, an event is logged. About one tick every 1.3s,
  // only while the figure is on screen and the tab is visible. Reduced motion keeps the still frame.
  const grid = document.getElementById("f1-grid");
  const log = document.getElementById("f1-log");
  if (grid && log && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const names = JSON.parse(log.dataset.names ?? "[]") as string[];
    const events = JSON.parse(log.dataset.events ?? "[]") as [string, string[]][];
    const cells = [...grid.children] as HTMLElement[];
    const pick = <T,>(a: T[]): T => a[Math.floor(Math.random() * a.length)]!;
    const clock = (d: Date) => d.toTimeString().slice(0, 8);

    // Start from the still frame, restamped to now.
    cells.forEach((c) => c.classList.remove("on", "open"));
    log.querySelectorAll<HTMLElement>(".t").forEach((t, i) => (t.textContent = clock(new Date(Date.now() - i * 1300))));

    const el = (tag: string, cls: string, ...kids: (Node | string)[]) => {
      const node = document.createElement(tag);
      node.className = cls;
      for (const k of kids) node.appendChild(typeof k === "string" ? document.createTextNode(k) : k);
      return node;
    };
    const tick = () => {
      const live = cells.filter((c) => c.offsetParent !== null);
      const c = pick(live);
      c.classList.add("on");
      setTimeout(() => {
        c.classList.replace("on", "open");
        setTimeout(() => c.classList.remove("open"), 1400);
      }, 900);

      const [from, tags] = pick(events);
      const what = el(
        "span",
        "what",
        el("b", "", `${pick(names)}@`),
        ` ← ${from}`,
        el("br", ""),
        ...tags.map((t, i) => el("span", i ? "tag" : "tag a", t)),
      );
      const row = el("div", "row new", el("span", "t", clock(new Date())), what);
      log.insertBefore(row, log.firstChild);
      while (log.children.length > 7) log.lastElementChild!.remove();
    };

    let timer = 0;
    let onScreen = false;
    const sync = () => {
      const run = onScreen && !document.hidden;
      if (run && !timer) timer = window.setInterval(tick, 1300);
      if (!run && timer) {
        clearInterval(timer);
        timer = 0;
      }
    };
    new IntersectionObserver(([entry]) => {
      onScreen = !!entry?.isIntersecting;
      sync();
    }).observe(grid.closest(".fig")!);
    document.addEventListener("visibilitychange", sync);
  }
</script>
