---
import { site } from "../site";
---

<section id="pricing" aria-labelledby="pricing-title">
  <div class="head">
    <div class="eyebrow">
      # Pricing <i aria-hidden="true">[simple]</i>
    </div>
    <h2 id="pricing-title">Free to run yourself</h2>
  </div>
  <div class="price">
    <div class="plan">
      <small>AVAILABLE TODAY</small>
      <h3>Self-host</h3>
      <div class="amt">$0</div>
      <ul>
        <li>The full server, AGPL-3.0</li>
        <li>Same API, SDKs and MCP</li>
        <li>Pay only for a server and mail relay</li>
      </ul>
      <a class="btn" href={site.docs.selfHost}>
        Self-host send0
      </a>
    </div>
    <div class="plan">
      <small class="acc">LAUNCHING SOON</small>
      <h3>send0 Cloud</h3>
      <div class="amt">Free</div>
      <ul>
        <li>Addresses on send0.email</li>
        <li>A reply-only free tier</li>
        <li>Webhooks included</li>
      </ul>
      <a class="btn acc" href="/#join">
        Join the waitlist
      </a>
    </div>
  </div>
</section>
