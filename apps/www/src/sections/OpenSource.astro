---
import { site } from "../site";
import { getRepoInfo } from "../lib/github";

const { version } = await getRepoInfo();
---

<section class="band" id="oss" aria-labelledby="oss-title">
  <div class="wrap two">
    <div class="copy">
      <div class="eyebrow">
        # Open source <i aria-hidden="true">[agpl-3.0 · mit sdks]</i>
      </div>
      <h2 id="oss-title">Run the whole thing on your own servers</h2>
      <p class="lede">
        The same code runs our cloud. Docker Compose on any server with port 25, or one Cloudflare Worker with a deploy button.
      </p>
      <div class="actions">
        <a class="btn" href={site.github} rel="noopener">
          View on GitHub
        </a>
        <a class="btn ghost" href={site.docs.selfHost}>
          Self-hosting guide
        </a>
      </div>
    </div>
    <div class="term">
      <div class="bar">
        <span>~/send0</span>
        <span>{version} · three commands</span>
      </div>
      <pre tabindex="0" aria-label="Self-host with Docker Compose"><span class="p">$</span> for f in compose.yml Caddyfile .env.example; do
    curl -fsSLO "…/send0-v2/{version}/selfhost/$f"; done
<span class="p">$</span> cp .env.example .env  <span class="c"># your domains and mail relay</span>
<span class="p">$</span> docker compose up -d
✓ postgres · send0 api + dashboard · smtp :25 · caddy</pre>
    </div>
  </div>
</section>
