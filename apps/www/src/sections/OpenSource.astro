---
import Parcel from "../illustrations/Parcel.astro";
import PaperPlane from "../illustrations/PaperPlane.astro";
import { site } from "../site";
import { getRepoInfo } from "../lib/github";

const repo = await getRepoInfo();
---

<section class="section" id="self-host" aria-labelledby="oss-title">
  <div class="wrap">
    <div class="top">
      <div class="copy">
        <span class="eyebrow">
          <b>05</b> Open source
        </span>
        <h2 id="oss-title" class="h2">
          Run the whole post office yourself.
        </h2>
        <p class="lede">AGPL server, MIT SDKs. The same code runs our cloud.</p>
        <div class="ctas">
          <a class="btn btn-ink" href={site.github} rel="noopener">
            View the source
          </a>
          <a class="btn btn-quiet" href={site.docs.selfHost}>
            Self-hosting guide
          </a>
        </div>
      </div>

      <div class="side">
        <div class="term" role="group" aria-label="Self-host quickstart">
          <div class="bar mono">
            <span>~/send0</span>
            <span>{repo.version} · three commands</span>
          </div>
          <pre class="mono"><span class="p">$</span> curl -fsSLO "https://raw.githubusercontent.com/send0-dev/\
send0-v2/{repo.version}/selfhost/{"{"}compose.yml,Caddyfile,.env.example{"}"}"
<span class="p">$</span> cp .env.example .env   <span class="c"># your domain, a sending relay, secrets</span>
<span class="p">$</span> docker compose up -d
<span class="c"># postgres, send0 (API, dashboard, SMTP on :25) and caddy for HTTPS</span></pre>
        </div>

        <div class="options">
          <a class="option" href={site.docs.docker}>
            <Parcel class="opt-ill" />
            <span>
              <strong>Docker Compose</strong>
              <span>Any server with port 25.</span>
            </span>
          </a>
          <a class="option" href={site.docs.cloudflare}>
            <PaperPlane class="opt-ill" />
            <span>
              <strong>One Cloudflare Worker</strong>
              <span>Deploy button, your Postgres and SES.</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .top {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 64px;
      align-items: center;
    }
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .term {
    background: var(--code-bg);
    color: var(--code-fg);
    border-radius: 12px;
    border: 1px solid var(--code-line);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 18px;
    background: var(--code-bar);
    border-bottom: 1px solid var(--code-line);
    font-size: 11.5px;
    color: var(--code-muted);
  }
  pre {
    margin: 0;
    padding: 18px 20px 20px;
    font-size: 12.75px;
    line-height: 1.85;
    overflow-x: auto;
  }
  .p {
    color: var(--code-key);
    user-select: none;
  }
  .c {
    color: var(--code-muted);
  }
  .options {
    display: grid;
    gap: 14px;
    margin-top: 18px;
  }
  @media (min-width: 640px) {
    .options {
      grid-template-columns: 1fr 1fr;
    }
  }
  .option {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 14px 16px;
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .option:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }
  .option :global(.opt-ill) {
    flex: none;
    width: 64px;
  }
  .option strong {
    display: block;
    font-weight: 600;
    font-size: 15px;
  }
  .option span span {
    display: block;
    margin-top: 2px;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--muted);
  }
</style>
