---
import Mailbox from "../illustrations/Mailbox.astro";
import Parcel from "../illustrations/Parcel.astro";
import PaperPlane from "../illustrations/PaperPlane.astro";
import { site } from "../site";
import { getRepoInfo } from "../lib/github";

const repo = await getRepoInfo();

type Cell = true | false | string;
const cols = ["send0", "Hosted inbox APIs", "Transactional email APIs", "Your own mail server"];
const rows: { label: string; cells: Cell[] }[] = [
  { label: "Inboxes created by API", cells: [true, true, false, "Scripts and config"] },
  { label: "Receives mail and keeps threads", cells: [true, true, "Inbound hooks only", "You build it"] },
  { label: "Codes and links extracted", cells: [true, "Varies", false, false] },
  { label: "Webhooks without a paid plan", cells: [true, "Varies by plan", true, "You build it"] },
  { label: "Open source, runs on your servers", cells: [true, false, false, true] },
];
---

<section class="section" id="self-host" aria-labelledby="oss-title">
  <div class="wrap">
    <div class="top">
      <div class="copy">
        <span class="eyebrow">Open source</span>
        <h2 id="oss-title" class="h2">
          Run the whole post office <em>yourself.</em>
        </h2>
        <p class="lede">
          The server is AGPL-3.0, and it's the same code that runs our cloud. The SDKs and the MCP server are MIT. Keep mail on your own
          network, and move between cloud and self-hosted without rewriting a line.
        </p>
        <div class="ctas">
          <a class="btn btn-ink" href={site.github} rel="noopener">
            View the source
          </a>
          <a class="btn btn-quiet" href={site.docs.selfHost}>
            Self-hosting guide
          </a>
        </div>
      </div>

      <div class="side">
        <div class="term" role="group" aria-label="Self-host quickstart">
          <div class="bar mono">
            <span>~/send0</span>
            <span>{repo.version} · three commands</span>
          </div>
          <pre class="mono"><span class="p">$</span> curl -fsSLO "https://raw.githubusercontent.com/send0-dev/\
send0-v2/{repo.version}/selfhost/{"{"}compose.yml,Caddyfile,.env.example{"}"}"
<span class="p">$</span> cp .env.example .env   <span class="c"># your domain, a sending relay, secrets</span>
<span class="p">$</span> docker compose up -d
<span class="c"># postgres, send0 (API, dashboard, SMTP on :25) and caddy for HTTPS</span></pre>
        </div>

        <div class="options">
          <a class="option" href={site.docs.docker}>
            <Parcel class="opt-ill" />
            <span>
              <strong>Docker Compose</strong>
              <span>Any server with port 25 open. Send through Amazon SES or any SMTP relay.</span>
            </span>
          </a>
          <a class="option" href={site.docs.cloudflare}>
            <PaperPlane class="opt-ill" />
            <span>
              <strong>One Cloudflare Worker</strong>
              <span>Deploy button, Email Routing in, your Postgres, R2 and Amazon SES.</span>
            </span>
          </a>
        </div>
        <Mailbox class="mailbox" />
      </div>
    </div>

    <div class="table-wrap">
      <table>
        <caption class="sr-only">send0 compared with other ways to give an agent email</caption>
        <thead>
          <tr>
            <th scope="col">
              <span class="sr-only">Capability</span>
            </th>
            {cols.map((c, i) => (
              <th scope="col" class:list={{ us: i === 0 }}>
                {c}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              {r.cells.map((c, i) => (
                <td class:list={{ us: i === 0 }}>
                  {c === true ? (
                    <span class="yes">
                      <svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="m3.5 8.5 3 3 6-7" />
                      </svg>
                      <span class="sr-only">Yes</span>
                    </span>
                  ) : c === false ? (
                    <span class="no">
                      <span aria-hidden="true">–</span>
                      <span class="sr-only">No</span>
                    </span>
                  ) : (
                    <span class="txt">{c}</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .top {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 64px;
      align-items: start;
    }
  }
  .side :global(.mailbox) {
    width: 132px;
    margin: 18px 4px -40px auto;
  }
  @media (max-width: 639px) {
    .side :global(.mailbox) {
      display: none;
    }
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .term {
    background: var(--code-bg);
    color: var(--code-fg);
    border-radius: 12px;
    border: 1px solid var(--code-line);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 18px;
    background: var(--code-bar);
    border-bottom: 1px solid var(--code-line);
    font-size: 11.5px;
    color: var(--code-muted);
  }
  pre {
    margin: 0;
    padding: 18px 20px 20px;
    font-size: 12.75px;
    line-height: 1.85;
    overflow-x: auto;
  }
  .p {
    color: var(--code-key);
    user-select: none;
  }
  .c {
    color: var(--code-muted);
  }
  .options {
    display: grid;
    gap: 14px;
    margin-top: 18px;
  }
  @media (min-width: 640px) {
    .options {
      grid-template-columns: 1fr 1fr;
    }
  }
  .option {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 14px 16px;
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .option:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }
  .option :global(.opt-ill) {
    flex: none;
    width: 64px;
  }
  .option strong {
    display: block;
    font-weight: 600;
    font-size: 15px;
  }
  .option span span {
    display: block;
    margin-top: 2px;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--muted);
  }
  .table-wrap {
    margin-top: 64px;
    overflow-x: auto;
    border: 1px solid var(--hairline);
    border-radius: 14px;
    background: var(--card);
  }
  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  th,
  td {
    padding: 14px 18px;
    text-align: left;
    border-bottom: 1px solid var(--hairline);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font: 500 11.5px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  tbody th {
    font-weight: 500;
    color: var(--ink);
  }
  .us {
    background: color-mix(in srgb, var(--butter) 60%, transparent);
  }
  thead .us {
    color: var(--ink);
    font-weight: 700;
  }
  .yes {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--ok-tint);
    color: var(--ok);
  }
  .yes svg {
    width: 14px;
    height: 14px;
  }
  .no {
    color: var(--faint);
  }
  .txt {
    color: var(--muted);
  }
</style>
