---
import Logo from "./Logo.astro";
import GithubIcon from "./GithubIcon.astro";
import { site } from "../site";

const links = [
  { href: "/#features", label: "Features" },
  { href: "/#how-it-works", label: "How it works" },
  { href: "/#self-host", label: "Self-host" },
  { href: "/#pricing", label: "Pricing" },
  { href: "/#faq", label: "FAQ" },
  { href: "/docs/", label: "Docs" },
];
---

<header class="nav">
  <div class="inner">
    <a href="/" class="brand" aria-label="send0 home"><Logo /></a>

    <nav class="links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="actions">
      <button class="icon-btn theme-toggle" type="button" aria-label="Toggle color theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path></svg>
      </button>
      {
        site.repoPublic && (
          <a class="icon-btn gh" href={site.github} aria-label="send0 on GitHub" rel="noopener">
            <GithubIcon size={18} />
          </a>
        )
      }
      <a class="btn btn-primary btn-sm cta" href="/#waitlist">Join the waitlist</a>
      <button class="icon-btn menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path class="l1" d="M4 8h16"></path><path class="l2" d="M4 16h16"></path></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile" hidden>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    {site.repoPublic && <a href={site.github} rel="noopener">GitHub</a>}
    <a class="btn btn-primary" href="/#waitlist">Join the waitlist</a>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  toggle?.addEventListener("click", () => {
    const current =
      root.getAttribute("data-theme") ??
      (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    const next = current === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("send0-theme", next);
    } catch {}
  });

  const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
  const menu = document.getElementById("mobile-menu");
  const setOpen = (open: boolean) => {
    if (!btn || !menu) return;
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menu.hidden = !open;
  };
  btn?.addEventListener("click", () => setOpen(btn.getAttribute("aria-expanded") !== "true"));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false));
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--rail);
  }
  .inner {
    max-width: calc(var(--column) + 2px);
    margin: 0 auto;
    height: 60px;
    padding: 0 16px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .inner {
      padding: 0 24px;
    }
  }
  .brand {
    display: inline-flex;
    margin-right: 8px;
  }
  .links {
    display: none;
    gap: 4px;
  }
  .links a {
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 14px;
    color: var(--fg-muted);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .links a:hover {
    color: var(--fg);
    background: var(--bg-subtle);
  }
  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 7px;
    border: 0;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .icon-btn:hover {
    color: var(--fg);
    background: var(--bg-subtle);
  }
  .icon-btn svg {
    width: 18px;
    height: 18px;
  }
  .theme-toggle .moon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .theme-toggle .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .theme-toggle .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle .sun {
      display: none;
    }
    :global(:root:not([data-theme="light"])) .theme-toggle .moon {
      display: block;
    }
  }
  .cta {
    display: none;
    margin-left: 6px;
  }
  .gh {
    display: none;
  }
  .menu-btn path {
    transition: transform 0.2s ease;
    transform-origin: center;
  }
  .menu-btn[aria-expanded="true"] .l1 {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-btn[aria-expanded="true"] .l2 {
    transform: translateY(-4px) rotate(-45deg);
  }
  .mobile {
    display: flex;
    flex-direction: column;
    padding: 8px 16px 20px;
    border-top: 1px solid var(--rail);
  }
  .mobile[hidden] {
    display: none;
  }
  .mobile a:not(.btn) {
    padding: 12px 4px;
    font-size: 16px;
    color: var(--fg-muted);
    border-bottom: 1px solid var(--border);
  }
  .mobile .btn {
    margin-top: 16px;
  }
  @media (min-width: 900px) {
    .links,
    .gh,
    .cta {
      display: inline-flex;
    }
    .menu-btn,
    .mobile {
      display: none !important;
    }
  }
</style>
