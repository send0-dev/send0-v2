---
import Logo from "./Logo.astro";
import { site } from "../site";
import { getRepoInfo, formatStars } from "../lib/github";

const repo = await getRepoInfo();
// A tiny count reads as a weakness; show it once it says something.
const stars = repo.stars !== null && repo.stars >= 10 ? formatStars(repo.stars) : null;
---

<header class="top">
  <div class="wrap">
    <a class="brand" href="/" aria-label="send0 home">
      <Logo />
    </a>
    <nav class="navlinks" aria-label="Primary">
      <a href="/#how">How it works</a>
      <a href="/#dev">Developers</a>
      <a href="/#oss">Self-host</a>
      <a href="/#pricing">Pricing</a>
      <a href={site.docs.home}>Docs</a>
    </nav>
    <div class="right">
      <button class="icon-btn theme-toggle" type="button" aria-label="Switch to dark theme">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25"></circle>
          <path d="M8 1.75v12.5A6.25 6.25 0 0 0 8 1.75Z" fill="currentColor" stroke="none"></path>
        </svg>
      </button>
      <a class="btn" href={site.github} rel="noopener">
        GitHub ★{stars && <span>{stars}</span>}
      </a>
      <a class="btn solid" href="/#join">
        Join waitlist
      </a>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle")!;
  const current = () => root.getAttribute("data-theme") ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  const label = () => toggle.setAttribute("aria-label", `Switch to ${current() === "dark" ? "light" : "dark"} theme`);
  label();
  toggle.addEventListener("click", () => {
    const next = current() === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    label();
    try {
      localStorage.setItem("send0-theme", next);
    } catch {
      // Private mode: the choice lasts for this page only.
    }
  });
</script>
