---
import Logo from "./Logo.astro";
import AirmailRule from "./AirmailRule.astro";
import { site } from "../site";
import { getRepoInfo } from "../lib/github";

const repo = await getRepoInfo();
const year = new Date().getFullYear();

const groups = [
  {
    title: "Product",
    links: [
      { href: "/docs", label: "Docs" },
      { href: site.docs.quickstart, label: "Quickstart" },
      { href: "/#pricing", label: "Pricing" },
      { href: "/#waitlist", label: "Waitlist" },
    ],
  },
  {
    title: "Open source",
    links: [
      { href: site.github, label: "GitHub" },
      { href: site.docs.selfHost, label: "Self-hosting" },
      { href: site.docs.llms, label: "Docs for LLMs" },
      { href: `${site.github}/blob/main/LICENSE`, label: "License (AGPL-3.0)" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/terms", label: "Terms" },
      { href: "/privacy", label: "Privacy" },
      { href: "/acceptable-use", label: "Acceptable use" },
    ],
  },
  {
    title: "Write to us",
    links: [
      { href: `mailto:${site.email.hello}`, label: site.email.hello },
      { href: `mailto:${site.email.support}`, label: site.email.support },
      { href: `mailto:${site.email.abuse}`, label: site.email.abuse },
    ],
  },
];
---

<footer class="footer">
  <AirmailRule />
  <div class="wrap top">
    <div class="about">
      <Logo />
      <p>Email inboxes for AI agents. Open source, self-hostable, webhooks on every plan.</p>
      <div class="meta mono">
        <span class="soon">
          <span class="dot" aria-hidden="true"></span>Launching soon
        </span>
        <a href={repo.releaseUrl} rel="noopener">
          Self-host {repo.version}
        </a>
      </div>
    </div>
    <div class="groups">
      {groups.map((g) => (
        <div>
          <h2>{g.title}</h2>
          <ul>
            {g.links.map((l) => (
              <li>
                <a href={l.href} rel={l.href.startsWith("http") ? "noopener" : undefined}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <div class="wrap">
    <div class="bottom">
      <span>
        © {year} {site.operator}. The send0 server is open source under AGPL-3.0.
      </span>
      <span class="mono">Made in {site.country}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--paper-alt);
  }
  .top {
    display: grid;
    gap: 44px;
    padding-block: 56px 44px;
  }
  @media (min-width: 900px) {
    .top {
      grid-template-columns: 1fr 2fr;
      padding-block: 72px 56px;
    }
  }
  .about {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .about p {
    max-width: 300px;
    color: var(--muted);
    font-size: 14.5px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .meta a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--rule);
  }
  .meta a:hover {
    color: var(--ink);
  }
  .soon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-bg);
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 24px;
  }
  @media (min-width: 640px) {
    .groups {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  h2 {
    margin-bottom: 14px;
    font: 500 11.5px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  li a {
    font-size: 14.5px;
    color: var(--ink);
    overflow-wrap: anywhere;
    transition: color 0.15s ease;
  }
  li a:hover {
    color: var(--accent);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 20px 32px;
    border-top: 1px solid var(--hairline);
    font-size: 13px;
    color: var(--muted);
  }
</style>
