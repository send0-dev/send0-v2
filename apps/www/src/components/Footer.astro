---
import Logo from "./Logo.astro";
import { site } from "../site";
---

<footer>
  <div class="wrap cols">
    <div>
      <a class="brand" href="/" aria-label="send0 home">
        <Logo />
      </a>
      <p class="about">Email inboxes for AI agents. Open source.</p>
    </div>
    <nav aria-labelledby="f-product">
      <h2 id="f-product">Product</h2>
      <ul>
        <li>
          <a href={site.docs.home}>Docs</a>
        </li>
        <li>
          <a href={site.docs.quickstart}>Quickstart</a>
        </li>
        <li>
          <a href="/#pricing">Pricing</a>
        </li>
      </ul>
    </nav>
    <nav aria-labelledby="f-oss">
      <h2 id="f-oss">Open source</h2>
      <ul>
        <li>
          <a href={site.github} rel="noopener">
            GitHub
          </a>
        </li>
        <li>
          <a href={site.docs.selfHost}>Self-hosting</a>
        </li>
        <li>
          <a href={site.docs.llms}>llms.txt</a>
        </li>
      </ul>
    </nav>
    <nav aria-labelledby="f-legal">
      <h2 id="f-legal">Legal</h2>
      <ul>
        <li>
          <a href="/terms">Terms</a>
        </li>
        <li>
          <a href="/privacy">Privacy</a>
        </li>
        <li>
          <a href="/acceptable-use">Acceptable use</a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
