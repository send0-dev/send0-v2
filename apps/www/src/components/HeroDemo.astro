---
// Scripted walkthrough: create an inbox, wait for mail, read the code, reply, watch the thread grow.
// The markup is the final state; the script only hides and replays steps. With reduced motion or
// no JavaScript, visitors see the finished scene. `?demo=0..6` freezes a step for checking layouts.
import Envelope from "../illustrations/Envelope.astro";
---

<div class="demo" data-demo aria-label="Animated example: an agent gets an inbox, receives a verification code and replies" role="figure">
  <div class="to mono" data-at="1">
    <span class="live" aria-hidden="true"></span>
    <span class="k">To</span> signup-agent@send0.email
  </div>

  <div class="code">
    <div class="bar">
      <span class="dots" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="file mono">agent.ts</span>
      <span class="status mono" data-only="2">
        <span class="spin" aria-hidden="true"></span>waiting for *@acme.dev
      </span>
    </div>
    <pre class="mono"><code><span class="ln" data-line="0"><span class="k">import</span> {"{"} Send0 {"}"} <span class="k">from</span> <span class="s">"@send0/sdk"</span>;</span>
<span class="ln" data-line="0"><span class="k">const</span> send0 = <span class="k">new</span> <span class="f">Send0</span>();</span>
<span class="ln"> </span>
<span class="ln" data-line="1"><span class="k">const</span> inbox = <span class="k">await</span> send0.inboxes.<span class="f">create</span>({"{"} name: <span class="s">"signup-agent"</span> {"}"});</span>
<span class="ln" data-line="1"><span class="k">await</span> page.<span class="f">fill</span>(<span class="s">"#email"</span>, inbox.address);</span>
<span class="ln"> </span>
<span class="ln" data-line="2 3"><span class="k">const</span> msg = <span class="k">await</span> send0.inboxes.<span class="f">wait</span>(inbox.id, {"{"} from: <span class="s">"*@acme.dev"</span> {"}"});</span>
<span class="ln" data-line="2 3"><span class="k">if</span> (!msg) <span class="k">return</span>;</span>
<span class="ln" data-line="4"><span class="k">await</span> page.<span class="f">fill</span>(<span class="s">"#code"</span>, msg.extracted?.otp ?? <span class="s">""</span>);</span>
<span class="ln"> </span>
<span class="ln" data-line="5 6"><span class="k">await</span> send0.messages.<span class="f">reply</span>(msg.id, {"{"} text: <span class="s">"Confirmed, thanks!"</span> {"}"});</span></code></pre>
  </div>

  <div class="env" data-at="3">
    <Envelope />
  </div>

  <div class="thread">
    <article class="letter" data-at="3">
      <header>
        <span class="avatar" aria-hidden="true">
          D
        </span>
        <div class="who">
          <strong>Dana at Acme</strong>
          <span class="mono">dana@acme.dev</span>
        </div>
        <span class="time mono">now</span>
      </header>
      <p class="subject">Welcome to Acme</p>
      <p class="body">
        Your access code is <mark data-at="4">482913</mark>. Reply to this email to confirm you're in.
      </p>
      <div class="chips mono">
        <span class="chip ok">spf · dkim · dmarc pass</span>
        <span class="chip">prompt_injection: none</span>
        <span class="chip otp" data-at="4">
          extracted.otp "482913"
        </span>
      </div>
    </article>
    <div class="slip out" data-at="5">
      <span class="who mono">signup-agent</span>
      <span class="text">Confirmed, thanks!</span>
      <span class="tag mono">sent</span>
    </div>
    <div class="slip" data-at="6">
      <span class="who mono">Dana</span>
      <span class="text">Great, you're all set.</span>
      <span class="tag mono">3 in thread</span>
    </div>
  </div>
</div>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-demo]").forEach((demo) => {
    const at = demo.querySelectorAll<HTMLElement>("[data-at]");
    const only = demo.querySelectorAll<HTMLElement>("[data-only]");
    const lines = demo.querySelectorAll<HTMLElement>("[data-line]");

    const show = (step: number) => {
      at.forEach((el) => el.classList.toggle("on", Number(el.dataset.at) <= step));
      only.forEach((el) => el.classList.toggle("on", Number(el.dataset.only) === step));
      lines.forEach((el) => el.classList.toggle("now", el.dataset.line!.split(" ").includes(String(step))));
    };

    const frozen = new URLSearchParams(location.search).get("demo");
    if (frozen) {
      demo.dataset.anim = "";
      show(Number(frozen));
      return;
    }
    if (reduce) return;

    // [step, how long it stays, ms]
    const timeline = [
      [0, 900],
      [1, 1500],
      [2, 1700],
      [3, 1500],
      [4, 1900],
      [5, 1600],
      [6, 4200],
    ] as const;
    let i = 0;
    let timer = 0;
    let visible = false;
    let held = false;

    const tick = () => {
      const [step, ms] = timeline[i]!;
      show(step);
      i = (i + 1) % timeline.length;
      timer = window.setTimeout(tick, ms);
    };
    const sync = () => {
      window.clearTimeout(timer);
      if (visible && !held) timer = window.setTimeout(tick, 400);
    };

    demo.dataset.anim = "";
    show(0);
    new IntersectionObserver(([e]) => {
      visible = !!e?.isIntersecting;
      sync();
    }).observe(demo);
    // Pause while someone is reading it.
    demo.addEventListener("mouseenter", () => ((held = true), sync()));
    demo.addEventListener("mouseleave", () => ((held = false), sync()));
    demo.addEventListener("focusin", () => ((held = true), sync()));
    demo.addEventListener("focusout", () => ((held = false), sync()));
  });
</script>

<style>
  .demo {
    position: relative;
    display: grid;
    gap: 14px;
    text-align: left;
  }

  /* ---- Address tag ---- */
  .to {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    background: var(--card);
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    font-size: 12.5px;
    box-shadow: 0 2px 0 var(--ink);
  }
  .to .k {
    color: var(--muted);
  }
  .live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px var(--ok-tint);
  }

  /* ---- Code card ---- */
  .code {
    min-width: 0;
    background: var(--code-bg);
    color: var(--code-fg);
    border-radius: 12px;
    border: 1px solid var(--code-line);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 38px;
    padding: 0 14px;
    background: var(--code-bar);
    border-bottom: 1px solid var(--code-line);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--code-line);
  }
  .file {
    font-size: 12px;
    color: var(--code-muted);
  }
  .status {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    color: var(--code-num);
  }
  .spin {
    width: 10px;
    height: 10px;
    border: 1.5px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  pre {
    margin: 0;
    padding: 14px 0 18px;
    white-space: normal;
    font-size: 12.25px;
    line-height: 1.8;
    overflow-x: auto;
  }
  code {
    display: block;
    min-width: max-content;
  }
  .ln {
    display: block;
    white-space: pre;
    padding: 0 18px 0 16px;
    border-left: 2px solid transparent;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      opacity 0.3s ease;
  }
  .k {
    color: var(--code-key);
  }
  .s {
    color: var(--code-str);
  }
  .f {
    color: var(--code-fn);
  }
  .demo[data-anim] .ln {
    opacity: 0.55;
  }
  .demo[data-anim] .ln.now {
    opacity: 1;
    background: rgb(255 143 92 / 0.1);
    border-left-color: var(--code-key);
  }

  /* ---- Envelope ---- */
  .env {
    display: none;
  }

  /* ---- Letter and replies ---- */
  .thread {
    position: relative;
    display: grid;
    gap: 10px;
  }
  /* the red thread that ties the conversation together */
  .thread::before {
    content: "";
    position: absolute;
    left: 22px;
    top: 40px;
    bottom: 22px;
    border-left: 1.5px dashed var(--airmail-red);
  }
  .letter {
    position: relative;
    padding: 16px 18px 16px;
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    box-shadow: var(--shadow);
  }
  .letter header {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--sage);
    border: 1.5px solid var(--ink);
    font: 600 13px/1 var(--font-display);
    position: relative;
    z-index: 1;
  }
  .who {
    display: grid;
    line-height: 1.25;
  }
  .who strong {
    font-size: 14px;
    font-weight: 600;
  }
  .who span {
    font-size: 11.5px;
    color: var(--muted);
  }
  .time {
    margin-left: auto;
    font-size: 11.5px;
    color: var(--muted);
  }
  .subject {
    margin-top: 12px;
    font: 500 17px/1.3 var(--font-display);
  }
  .body {
    margin-top: 4px;
    font-size: 14px;
    color: var(--muted);
  }
  mark {
    padding: 0 3px;
    border-radius: 3px;
    color: var(--ink);
    font: 600 14px var(--font-mono);
    background: linear-gradient(var(--butter), var(--butter)) no-repeat 0 0 / 100% 100%;
    box-shadow: inset 0 -2px 0 var(--postal);
    transition: background-size 0.5s ease;
  }
  .demo[data-anim] mark:not(.on) {
    background-size: 0% 100%;
    box-shadow: none;
    color: inherit;
    font-weight: 400;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }
  .chip {
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid var(--hairline);
    background: var(--paper);
    font-size: 11px;
    color: var(--muted);
  }
  .chip.ok {
    color: var(--ok);
    background: var(--ok-tint);
    border-color: transparent;
  }
  .chip.otp {
    color: var(--ink);
    background: var(--butter);
    border-color: color-mix(in srgb, var(--postal) 50%, transparent);
  }
  .slip {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px 10px 42px;
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    box-shadow: var(--shadow-sm);
    font-size: 14px;
  }
  .slip::before {
    content: "";
    position: absolute;
    left: 17px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--sage);
    border: 1.5px solid var(--ink);
  }
  .slip.out::before {
    background: var(--postal);
  }
  .slip .who {
    font-size: 12px;
    color: var(--muted);
  }
  .slip .text {
    flex: 1;
    min-width: 0;
  }
  .tag {
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
  }
  .slip.out .tag {
    color: var(--postal-ink);
  }

  /* ---- Step visibility (only while the script is running) ---- */
  .demo[data-anim] [data-at],
  .demo[data-anim] [data-only] {
    transition:
      opacity 0.45s ease,
      transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .demo:not([data-anim]) .status {
    display: none;
  }
  .demo[data-anim] :is(.to, .letter, .slip, .chip.otp, .status):not(.on) {
    opacity: 0;
    transform: translateY(8px);
  }
  .demo[data-anim] .letter.on {
    transition-delay: 0.3s;
  }

  /* ---- Desktop: an arranged desk ---- */
  @media (min-width: 1180px) {
    .demo {
      display: block;
      height: 600px;
    }
    .to {
      position: absolute;
      top: 0;
      right: 0;
      z-index: 3;
      transform: rotate(2deg);
    }
    .demo[data-anim] .to:not(.on) {
      transform: rotate(2deg) translateY(-8px);
    }
    .code {
      position: absolute;
      top: 22px;
      left: 0;
      width: 92%;
      z-index: 1;
    }
    .env {
      display: block;
      position: absolute;
      left: -4px;
      top: 372px;
      width: 172px;
      z-index: 2;
      transform: rotate(-9deg);
    }
    .demo[data-anim] .env {
      transition:
        opacity 0.4s ease,
        transform 0.8s cubic-bezier(0.2, 0.9, 0.25, 1.1);
    }
    .demo[data-anim] .env:not(.on) {
      opacity: 0;
      transform: translate(340px, -40px) rotate(14deg);
    }
    .thread {
      position: absolute;
      right: 0;
      top: 318px;
      width: 64%;
      z-index: 3;
    }
  }
</style>
