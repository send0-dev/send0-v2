---
// The route a letter takes from someone's mail server to your agent.
// Motion: as you scroll through it, an envelope travels the dotted route and each stop lights up as it
// passes (scroll-driven animations). Browsers without them play the trip once on entry; reduced motion
// shows the finished route.
interface Stop {
  title: string;
  body: string;
}
interface Props {
  stops: Stop[];
}
const { stops } = Astro.props;
---

<div class="journey" data-in>
  <svg class="route" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M10 22C120 8 210 34 330 20S560 8 670 22 880 34 990 18"
      fill="none"
      stroke="var(--ink)"
      stroke-width="1.75"
      stroke-dasharray="2 7"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    ></path>
  </svg>
  <div class="lane" aria-hidden="true">
    <div class="carrier">
      <svg
        class="mover"
        viewBox="0 0 30 21"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M1.5 2.2c9-.6 18-.6 27 .2l-.4 16.6c-9 .5-17.8.4-26.4-.2Z" fill="var(--card)"></path>
        <path d="m1.8 2.6 13 9.4 13.4-9.4"></path>
        <path d="M21.5 5.5h4v4.6h-4Z" fill="var(--accent-bg)" stroke="none"></path>
      </svg>
    </div>
  </div>
  <ol>
    {stops.map((s, i) => (
      <li style={`--k:${i}`}>
        <span class="stop mono" aria-hidden="true">
          <span>{String(i + 1).padStart(2, "0")}</span>
        </span>
        <h3>{s.title}</h3>
        <p>{s.body}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .journey {
    position: relative;
    view-timeline-name: --route;
  }
  .route,
  .lane {
    display: none;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 26px;
    position: relative;
  }
  /* phones: a vertical route down the left */
  ol::before {
    content: "";
    position: absolute;
    left: 21px;
    top: 10px;
    bottom: 10px;
    border-left: 1.75px dotted var(--ink);
  }
  li {
    position: relative;
    padding-left: 62px;
  }
  .stop {
    position: absolute;
    left: 0;
    top: -6px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--card);
    border: 1.5px solid var(--ink);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--on-accent);
    overflow: hidden;
    isolation: isolate;
  }
  /* The lit state is the default (and the final state); the animation starts it dark. */
  .stop::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 50%;
    background: var(--accent-bg);
  }
  h3 {
    font-size: 20px;
  }
  p {
    margin-top: 6px;
    font-size: 14.5px;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .route {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: 2px;
      width: 100%;
      height: 40px;
    }
    .lane {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: -26px;
      height: 24px;
      overflow: visible;
    }
    /* A full-width carrier with the envelope at its right edge; translating it moves the envelope
       from stop 01 (k=0) to stop 05 (k=4). Each stop centre sits at k·(20% + 5.6px) + 22px. */
    .carrier {
      position: relative;
      width: 100%;
      height: 100%;
      transform: translateX(calc(-20% + 59px));
    }
    .mover {
      position: absolute;
      right: 0;
      width: 30px;
      color: var(--ink);
    }
    ol {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 28px;
    }
    ol::before {
      display: none;
    }
    li {
      padding: 64px 0 0;
    }
    .stop {
      top: 0;
    }
  }

  @keyframes travel {
    0% {
      transform: translateX(calc(-100% + 37px)) rotate(-4deg);
    }
    25% {
      transform: translateX(calc(-80% + 42.6px)) rotate(3deg);
    }
    50% {
      transform: translateX(calc(-60% + 48.2px)) rotate(-3deg);
    }
    75% {
      transform: translateX(calc(-40% + 53.8px)) rotate(3deg);
    }
    100% {
      transform: translateX(calc(-20% + 59.4px)) rotate(0deg);
    }
  }
  @keyframes unlit {
    from {
      transform: scale(0);
    }
  }
  @keyframes ink-number {
    from {
      color: var(--ink);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .carrier {
        animation: travel linear both;
        animation-timeline: --route;
        animation-range: cover 15% cover 48%;
      }
      .stop::before {
        animation: unlit 0.3s var(--ease-out) both;
        animation-timeline: --route;
        animation-range: cover calc(15% + var(--k) * 8.25%) cover calc(17% + var(--k) * 8.25%);
      }
      .stop span {
        animation: ink-number linear both;
        animation-timeline: --route;
        animation-range: cover calc(15% + var(--k) * 8.25%) cover calc(17% + var(--k) * 8.25%);
      }
    }
    @supports not (animation-timeline: view()) {
      :global(html.js) .journey:not(:global(.in)) .stop::before {
        transform: scale(0);
      }
      :global(html.js) .journey:not(:global(.in)) .stop span {
        color: var(--ink);
      }
      :global(html.js) .journey:global(.in) .carrier {
        animation: travel 3.2s cubic-bezier(0.45, 0, 0.55, 1) both;
      }
      :global(html.js) .journey:global(.in) .stop::before {
        animation: unlit 0.4s var(--ease-out) both calc(var(--k) * 0.75s);
      }
      :global(html.js) .journey:global(.in) .stop span {
        animation: ink-number 0.4s both calc(var(--k) * 0.75s);
      }
    }
  }
</style>
