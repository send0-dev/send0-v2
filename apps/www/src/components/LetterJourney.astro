---
// The route a letter takes from someone's mail server to your agent, drawn as a postal route.
interface Stop {
  title: string;
  body: string;
}
interface Props {
  stops: Stop[];
}
const { stops } = Astro.props;
---

<div class="journey">
  <svg class="route" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M10 22C120 8 210 34 330 20S560 8 670 22 880 34 990 18"
      fill="none"
      stroke="var(--ink)"
      stroke-width="1.75"
      stroke-dasharray="2 7"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    ></path>
  </svg>
  <span class="mover" aria-hidden="true">
    <svg viewBox="0 0 30 21" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M1.5 2.2c9-.6 18-.6 27 .2l-.4 16.6c-9 .5-17.8.4-26.4-.2Z" fill="var(--card)"></path>
      <path d="m1.8 2.6 13 9.4 13.4-9.4"></path>
      <path d="M21.5 5.5h4v4.6h-4Z" fill="var(--postal)" stroke="none"></path>
    </svg>
  </span>
  <ol>
    {stops.map((s, i) => (
      <li class="reveal">
        <span class="stop mono" aria-hidden="true">
          {String(i + 1).padStart(2, "0")}
        </span>
        <h3>{s.title}</h3>
        <p>{s.body}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .journey {
    position: relative;
  }
  .route {
    display: none;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 26px;
    position: relative;
  }
  /* phones: a vertical route down the left */
  ol::before {
    content: "";
    position: absolute;
    left: 21px;
    top: 10px;
    bottom: 10px;
    border-left: 1.75px dotted var(--ink);
  }
  li {
    position: relative;
    padding-left: 62px;
  }
  .stop {
    position: absolute;
    left: 0;
    top: -6px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--card);
    border: 1.5px solid var(--ink);
    outline: 1px dashed var(--ink);
    outline-offset: -6px;
    font-size: 12.5px;
    font-weight: 600;
  }
  li:last-child .stop {
    background: var(--postal);
    color: var(--on-postal);
  }
  h3 {
    font-size: 21px;
  }
  p {
    margin-top: 6px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .mover {
    display: none;
  }
  @media (min-width: 900px) {
    .mover {
      display: block;
      position: absolute;
      top: -24px;
      left: 7px;
      width: 30px;
      z-index: 1;
      color: var(--ink);
      animation: travel 14s cubic-bezier(0.45, 0, 0.55, 1) infinite both;
    }
    .route {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: 2px;
      width: 100%;
      height: 40px;
    }
    ol {
      grid-template-columns: repeat(var(--n, 5), minmax(0, 1fr));
      gap: 28px;
    }
    ol::before {
      display: none;
    }
    li {
      padding: 64px 0 0;
    }
    .stop {
      top: 0;
    }
  }
  /* The letter stops at each post office along the way, then arrives. */
  @keyframes travel {
    0% {
      left: 0;
      opacity: 0;
      transform: rotate(-6deg);
    }
    6% {
      opacity: 1;
    }
    20% {
      left: 20.5%;
      transform: rotate(4deg);
    }
    40% {
      left: 41%;
      transform: rotate(-4deg);
    }
    60% {
      left: 61.5%;
      transform: rotate(4deg);
    }
    80%,
    100% {
      left: 82%;
      transform: rotate(-3deg);
    }
  }
</style>
