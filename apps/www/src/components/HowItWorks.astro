---
const lanes = [
  {
    name: "Inbound",
    caption: "From someone's mail server to your agent",
    steps: [
      {
        title: "Accept",
        body: "The recipient is checked while the SMTP session is still open. Mail to unknown addresses is refused, not bounced later.",
      },
      {
        title: "Store",
        body: "The raw message is written to storage before anything else, so a failed step never loses mail.",
      },
      {
        title: "Understand",
        body: "Parse MIME, strip quoted history, extract codes and links, read SPF, DKIM and DMARC results, flag likely prompt injection.",
      },
      {
        title: "Thread",
        body: "Match In-Reply-To and References first, then subject and participants, so the message joins the right conversation.",
      },
      {
        title: "Notify",
        body: "Fire the webhook, push to live streams, and wake any wait call that's listening.",
      },
    ],
  },
  {
    name: "Outbound",
    caption: "From your agent to someone's inbox",
    steps: [
      {
        title: "Check",
        body: "Apply the inbox's send policy, the suppression list and your quota before anything is queued.",
      },
      {
        title: "Queue",
        body: "Writes are idempotent and queued, so retries and restarts never send a message twice.",
      },
      {
        title: "Sign",
        body: "Build the MIME, set threading headers and sign with DKIM for the inbox's domain.",
      },
      {
        title: "Deliver",
        body: "Hand off to Amazon SES, with each organization isolated so one sender can't affect another.",
      },
      {
        title: "Track",
        body: "Delivered, bounced and complained events come back as webhooks. Bounces and complaints update suppression automatically.",
      },
    ],
  },
];
---

<section class="section" id="how-it-works" aria-labelledby="how-title">
  <div class="section-head reveal">
    <span class="eyebrow">How it works</span>
    <h2 id="how-title" class="h2">The plumbing, done properly. <span class="dim">So you never have to.</span></h2>
    <p class="lede">
      Email has fifty years of edge cases. send0 handles MIME, threading, authentication and deliverability, so
      your agent gets clean, structured messages and your replies land where they should.
    </p>
  </div>

  <div class="lanes">
    {
      lanes.map((lane) => (
        <div class="lane reveal">
          <div class="lane-head">
            <h3>{lane.name}</h3>
            <span class="mono">{lane.caption}</span>
          </div>
          <ol>
            {lane.steps.map((s, i) => (
              <li>
                <span class="step mono">{String(i + 1).padStart(2, "0")}</span>
                <h4>{s.title}</h4>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>

  <div class="callout reveal">
    <div>
      <h3>Every outbound message gets an ID that points home.</h3>
      <p>
        send0 sets <code>Message-ID: &lt;msg_…@send0.email&gt;</code> on everything it sends. When someone replies, the
        reply maps straight back to the right inbox and thread, even if they change the subject line or add people.
      </p>
    </div>
    <pre class="headers mono" aria-label="Example threading headers"><span class="h">Message-ID:</span> &lt;msg_9Kd2@send0.email&gt;
<span class="h">In-Reply-To:</span> &lt;CAF7x…@mail.gmail.com&gt;
<span class="h">References:</span> &lt;msg_4Tq1@send0.email&gt;
            &lt;CAF7x…@mail.gmail.com&gt;
<span class="h">Subject:</span> Re: PO #4471 delivery date</pre>
  </div>
</section>

<style>
  .lanes {
    display: grid;
    gap: 20px;
  }
  .lane {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  .lane-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 16px;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
  }
  .lane-head h3 {
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .lane-head span {
    font-size: 12px;
    color: var(--fg-faint);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  @media (min-width: 900px) {
    ol {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  li {
    position: relative;
    padding: 24px;
    border-top: 1px solid var(--border);
  }
  li:first-child {
    border-top: 0;
  }
  @media (min-width: 900px) {
    li {
      border-top: 0;
      border-left: 1px solid var(--border);
    }
    li:first-child {
      border-left: 0;
    }
    /* arrow between steps */
    li:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 30px;
      right: -5px;
      width: 9px;
      height: 9px;
      border-top: 1px solid var(--border-strong);
      border-right: 1px solid var(--border-strong);
      background: var(--surface);
      transform: rotate(45deg);
      z-index: 1;
    }
  }
  .step {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 20px;
    border-radius: 5px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-size: 11px;
    font-weight: 600;
  }
  h4 {
    margin-top: 14px;
    font-size: 16px;
    letter-spacing: -0.01em;
  }
  li p {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-muted);
  }
  .callout {
    display: grid;
    gap: 28px;
    margin-top: 20px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  @media (min-width: 900px) {
    .callout {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 40px;
      padding: 36px;
    }
  }
  .callout h3 {
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .callout p {
    margin-top: 12px;
    color: var(--fg-muted);
    font-size: 15px;
  }
  .callout code {
    font-size: 13px;
    color: var(--fg);
  }
  .headers {
    margin: 0;
    padding: 20px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--code-bg);
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--fg-muted);
    overflow-x: auto;
  }
  .headers .h {
    color: var(--accent-ink);
  }
</style>
