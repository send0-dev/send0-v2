---
// A circular cancellation mark beside a two-line label. The text is real HTML; the mark is decoration.
interface Props {
  title: string;
  detail: string;
  tone?: "postal" | "blue" | "ink";
}
const { title, detail, tone = "ink" } = Astro.props;
---

<span class:list={["postmark", tone]}>
  <svg viewBox="0 0 44 44" width="32" height="32" aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round">
    <path
      d="M22 3.2c10.3.2 18.6 8.4 18.8 18.6.2 10.5-8.2 19-18.6 19.1C11.8 41 3.3 32.6 3.2 22.2 3.1 11.7 11.5 3 22 3.2Z"
      stroke-width="1.6"
    ></path>
    <circle cx="22" cy="22" r="13.6" stroke-width="1.1" stroke-dasharray="1.2 2.6"></circle>
    <path d="M13.5 19.5c2.8-2 5.7 2 8.5 0s5.7 2 8.5 0M13.5 24.5c2.8-2 5.7 2 8.5 0s5.7 2 8.5 0" stroke-width="1.5"></path>
  </svg>
  <span class="txt">
    <strong>{title}</strong>
    <span>{detail}</span>
  </span>
</span>

<style>
  .postmark {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
  }
  .postmark svg {
    flex: none;
    transform: rotate(-8deg);
  }
  .postal svg {
    color: var(--postal-ink);
  }
  .blue svg {
    color: var(--airmail-blue);
  }
  .ink svg {
    color: var(--ink);
  }
  .txt {
    display: grid;
    line-height: 1.3;
  }
  strong {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }
  .txt span {
    font: 11.5px/1.35 var(--font-mono);
    color: var(--muted);
  }
</style>
