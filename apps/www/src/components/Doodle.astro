---
// A hand-drawn underline or ring around a key word. It draws itself in; keep it to two or three a page.
interface Props {
  kind?: "under" | "ring";
}
const { kind = "under" } = Astro.props;
---

<span class:list={["doodle", kind]}>
  <slot />
  {kind === "under" ? (
    <svg data-draw viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true">
      <path pathLength="1" d="M3 9.5C42 4.8 96 3.6 146 4.6c18 .4 34 1.6 51 3.4" stroke-width="2.6" />
      <path pathLength="1" d="M22 12.2c40-2.6 92-3.4 140-1.8" stroke-width="1.8" />
    </svg>
  ) : (
    <svg data-draw viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true">
      <path
        pathLength="1"
        d="M128 5.5C82 1.6 24 6 8.6 22.4-2.4 34.6 20 52.6 78 56.2c56 3.4 106-4.6 114.6-22C200.8 17 164 3.6 104 4 78 4.2 54 7.4 40 12"
        stroke-width="2"
      />
    </svg>
  )}
</span>
