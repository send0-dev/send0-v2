---
const icons: Record<string, string> = {
  inbox: '<path d="M3 13h5l1.5 2.5h5L16 13h5"/><path d="M5.5 5h13L21 13v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5L5.5 5Z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  thread: '<path d="M21 12a8 8 0 0 1-11.8 7L4 20.5l1.5-5A8 8 0 1 1 21 12Z"/><path d="M8.5 10.5h7M8.5 13.5h4.5"/>',
  bolt: '<path d="M13 3 5 13.5h6L10 21l8-10.5h-6L13 3Z"/>',
  key: '<circle cx="8" cy="15" r="4"/><path d="m11 12 9-9M17 6l3 3M15 8l2 2"/>',
  shield: '<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.3 7.5 9.5 4.3-1.2 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m9 12 2 2 4-4"/>',
  check: '<rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M3.5 9h17"/><path d="m9 14 2 2 4-4"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/>',
  flask: '<path d="M9 3h6M10 3v6l-5.5 9.2A2 2 0 0 0 6.2 21h11.6a2 2 0 0 0 1.7-2.8L14 9V3"/><path d="M7.5 15h9"/>',
};

const features = [
  {
    icon: "inbox",
    title: "An inbox in one call",
    body: "Create an address on send0.email or your own domain in milliseconds. Tag work with plus-addressing, like bot+task42@, without creating more inboxes.",
    api: "POST /v1/inboxes",
  },
  {
    icon: "clock",
    title: "Wait instead of polling",
    body: "A long-poll endpoint returns the moment a matching message lands, with one-time codes and links already pulled out. No polling loops, no regexes in your prompts.",
    api: "GET /messages/wait",
  },
  {
    icon: "thread",
    title: "Threads that hold up",
    body: "Replies carry proper Message-ID, In-Reply-To and References headers, so conversations stay threaded in Gmail, Outlook and Apple Mail. Quoted history is stripped, so your agent spends fewer tokens.",
    api: "POST /messages/{id}/reply",
  },
  {
    icon: "bolt",
    title: "Webhooks on every plan",
    body: "Signed with HMAC-SHA256 and retried for 24 hours, with a delivery log you can replay. Prefer a stream? Subscribe over SSE or WebSocket instead.",
    api: "message.received",
  },
  {
    icon: "key",
    title: "Keys scoped to one inbox",
    body: "Give each agent a key that can only touch its own mailbox, with separate read, send and admin permissions. A leaked key exposes one inbox, not your whole account.",
    api: "s0_live_… · inbox_ids",
  },
  {
    icon: "shield",
    title: "Safety on every message",
    body: "Each inbound message includes SPF, DKIM and DMARC results, a spam score and a prompt-injection flag. Inboxes can drop mail that fails authentication before your agent sees it.",
    api: "auth · safety",
  },
  {
    icon: "check",
    title: "Human approval",
    body: "Set an inbox to open, reply-only or approval. In approval mode, outgoing mail waits as a draft until a person signs off, through the API, the dashboard or a webhook.",
    api: "POST /drafts/{id}/send",
  },
  {
    icon: "globe",
    title: "Your own domain",
    body: "Run agents on an address like agents.yourcompany.com. send0 lists the MX, SPF, DKIM and DMARC records to add and checks them for you.",
    api: "POST /v1/domains",
  },
  {
    icon: "flask",
    title: "Sandbox inboxes",
    body: "Receive-only test addresses on a separate domain, made for CI and staging. Use them freely without affecting the reputation of your real inboxes.",
    api: "mode: sandbox",
  },
];
---

<section class="section" id="features" aria-labelledby="features-title">
  <div class="section-head reveal">
    <span class="eyebrow">Features</span>
    <h2 id="features-title" class="h2">Everything an agent needs from email. <span class="dim">Nothing it doesn't.</span></h2>
    <p class="lede">
      send0 treats the inbox as the main object, not an add-on to a sending API. Receiving, threading and
      real-time events work on day one.
    </p>
  </div>

  <div class="grid">
    {
      features.map((f) => (
        <article class="feature reveal">
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[f.icon]} />
          </span>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
          <code class="api">{f.api}</code>
        </article>
      ))
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 26px;
    background: var(--surface);
    transition: background-color 0.2s ease;
  }
  .feature:hover {
    background: var(--bg-subtle);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 8px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
  }
  .feature:hover .icon {
    color: var(--accent);
  }
  .icon svg {
    width: 18px;
    height: 18px;
  }
  h3 {
    font-size: 17px;
    letter-spacing: -0.015em;
  }
  p {
    color: var(--fg-muted);
    font-size: 14.5px;
    line-height: 1.6;
  }
  .api {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 10px;
    font-size: 12px;
    color: var(--fg-faint);
  }
</style>
