---
// Numbered steps on one line. Motion: as the section scrolls past, a blue line fills along the track
// and each step lights up (scroll-driven; a timed run where unsupported; finished state with reduced motion).
interface Step {
  title: string;
  body: string;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<div class="steps" data-in>
  <div class="track" aria-hidden="true">
    <span class="fill"></span>
  </div>
  <ol>
    {steps.map((s, i) => (
      <li style={`--k:${i}`}>
        <span class="num mono" aria-hidden="true">
          <span>{i + 1}</span>
        </span>
        <h3>{s.title}</h3>
        <p>{s.body}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .steps {
    position: relative;
    view-timeline-name: --steps;
  }
  .track {
    display: none;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
    position: relative;
  }
  /* phones: a vertical line down the left */
  ol::before {
    content: "";
    position: absolute;
    left: 15px;
    top: 8px;
    bottom: 8px;
    border-left: 1px solid var(--rule);
  }
  li {
    position: relative;
    padding-left: 50px;
  }
  .num {
    position: absolute;
    left: 0;
    top: -3px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--card);
    border: 1px solid var(--rule);
    font-size: 13px;
    font-weight: 600;
    color: var(--on-accent);
    overflow: hidden;
    isolation: isolate;
  }
  /* Lit is the default and final state; the animation starts it unlit. */
  .num::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 50%;
    background: var(--accent-bg);
  }
  h3 {
    font-size: 18px;
  }
  p {
    margin-top: 4px;
    font-size: 14.5px;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .track {
      display: block;
      position: absolute;
      left: 16px;
      right: 16px;
      top: 15px;
      height: 2px;
      background: var(--rule);
      border-radius: 2px;
      overflow: hidden;
    }
    .fill {
      position: absolute;
      inset: 0;
      background: var(--accent-bg);
      transform-origin: left;
    }
    ol {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 28px;
    }
    ol::before {
      display: none;
    }
    li {
      padding: 52px 0 0;
    }
    .num {
      top: 0;
    }
  }

  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes unlit {
    from {
      transform: scale(0);
    }
  }
  @keyframes ink-number {
    from {
      color: var(--ink);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .fill {
        animation: grow linear both;
        animation-timeline: --steps;
        animation-range: cover 15% cover 48%;
      }
      .num::before {
        animation: unlit 0.3s var(--ease-out) both;
        animation-timeline: --steps;
        animation-range: cover calc(15% + var(--k) * 8.25%) cover calc(17% + var(--k) * 8.25%);
      }
      .num span {
        animation: ink-number linear both;
        animation-timeline: --steps;
        animation-range: cover calc(15% + var(--k) * 8.25%) cover calc(17% + var(--k) * 8.25%);
      }
    }
    @supports not (animation-timeline: view()) {
      :global(html.js) .steps:not(:global(.in)) .fill {
        transform: scaleX(0);
      }
      :global(html.js) .steps:not(:global(.in)) .num::before {
        transform: scale(0);
      }
      :global(html.js) .steps:not(:global(.in)) .num span {
        color: var(--ink);
      }
      :global(html.js) .steps:global(.in) .fill {
        animation: grow 3s linear both;
      }
      :global(html.js) .steps:global(.in) .num::before {
        animation: unlit 0.4s var(--ease-out) both calc(var(--k) * 0.75s);
      }
      :global(html.js) .steps:global(.in) .num span {
        animation: ink-number 0.4s both calc(var(--k) * 0.75s);
      }
    }
  }
</style>
