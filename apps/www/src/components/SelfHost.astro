---
import { site } from "../site";

const rows = [
  { part: "HTTP API", cloud: "Hono on Cloudflare Workers", self: "The same Hono app on Node" },
  { part: "Receiving", cloud: "Cloudflare Email Routing", self: "Built-in SMTP listener" },
  { part: "Sending", cloud: "Amazon SES, isolated per org", self: "Amazon SES or any SMTP relay" },
  { part: "Database", cloud: "Postgres", self: "Postgres 17" },
  { part: "Files", cloud: "Cloudflare R2", self: "Local disk or any S3" },
  { part: "Queues", cloud: "Cloudflare Queues", self: "pg-boss on Postgres, no Redis" },
  { part: "Real-time", cloud: "Durable Objects", self: "Postgres LISTEN/NOTIFY" },
];
---

<section class="section" id="self-host" aria-labelledby="selfhost-title">
  <div class="top">
    <div class="section-head reveal">
      <span class="eyebrow">Open source</span>
      <h2 id="selfhost-title" class="h2">
        Same API. <span class="dim">Your infrastructure.</span>
      </h2>
      <p class="lede">
        {site.repoPublic ? "The server is open source under AGPL-3.0" : "The server will be open source under AGPL-3.0 from the beta"}, and
        the self-hosted edition runs the same code as our cloud. Keep mail and data inside your own network when compliance or data
        residency requires it, and switch between cloud and self-hosted without rewriting a line.
      </p>
      <div class="ctas">
        {site.repoPublic && (
          <a class="btn btn-primary" href={site.github} rel="noopener">
            View the source
          </a>
        )}
        {site.repoPublic ? (
          <a class="btn btn-secondary" href={`${site.github}/tree/main/selfhost#readme`} rel="noopener">
            Self-hosting guide
          </a>
        ) : (
          <a class="btn btn-primary" href="#waitlist">
            Get notified at beta
          </a>
        )}
      </div>
    </div>

    <div class="term card reveal" aria-label="Self-hosting commands">
      <div class="bar mono">
        <span>~/send0</span>
        <span class="soon">{site.repoPublic ? "v0.1 · Docker or Cloudflare" : "self-host guide ships with beta"}</span>
      </div>
      <pre class="mono"><span class="p">$</span> git clone {site.github.replace("https://", "")}
<span class="p">$</span> cd send0-v2/selfhost && cp .env.example .env
<span class="p">$</span> docker compose up -d
<span class="o">✓ postgres   ✓ send0 (api · smtp · worker)   ✓ caddy</span>
<span class="p">$</span> docker compose exec send0 send0 doctor
<span class="o">send0 is running at https://mail.yourcompany.com</span></pre>
    </div>
  </div>

  <div class="table-wrap reveal">
    <table>
      <caption class="sr-only">How send0 runs in the cloud and when self-hosted</caption>
      <thead>
        <tr>
          <th scope="col"></th>
          <th scope="col">send0 Cloud</th>
          <th scope="col">Self-hosted</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{r.part}</th>
            <td>{r.cloud}</td>
            <td>{r.self}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .top {
    display: grid;
    gap: 40px;
    margin-bottom: 40px;
  }
  @media (min-width: 1000px) {
    .top {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
      align-items: center;
    }
    .top .section-head {
      margin-bottom: 0;
    }
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }
  .term {
    min-width: 0;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
    font-size: 11.5px;
    color: var(--fg-faint);
  }
  .soon {
    color: var(--accent-ink);
  }
  .term pre {
    margin: 0;
    padding: 20px;
    background: var(--code-bg);
    font-size: 12.5px;
    line-height: 1.9;
    overflow-x: auto;
  }
  .p {
    color: var(--accent);
    user-select: none;
  }
  .o {
    color: var(--fg-faint);
  }
  .table-wrap {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-x: auto;
    background: var(--surface);
  }
  table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  th,
  td {
    padding: 14px 20px;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    background: var(--bg-subtle);
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  tbody th {
    width: 22%;
    font-weight: 500;
    color: var(--fg);
  }
  td {
    color: var(--fg-muted);
  }
</style>
