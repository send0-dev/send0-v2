---
// Tabbed code panel. Highlighting happens at build time with a warm theme that matches the site.
import { Code } from "astro:components";

export interface Tab {
  id: string;
  label: string;
  file: string;
  lang: "ts" | "python" | "bash" | "json";
  note: string;
  code: string;
}
interface Props {
  tabs: Tab[];
  label: string;
}
const { tabs, label } = Astro.props;

const warm = {
  name: "send0-warm",
  type: "dark",
  colors: { "editor.background": "#1f1b17", "editor.foreground": "#ede4d6" },
  settings: [
    { settings: { foreground: "#ede4d6" } },
    { scope: ["comment", "punctuation.definition.comment"], settings: { foreground: "#a39581", fontStyle: "italic" } },
    { scope: ["keyword", "storage", "storage.type", "keyword.control", "keyword.operator.new"], settings: { foreground: "#ff8f5c" } },
    { scope: ["string", "string.quoted", "punctuation.definition.string"], settings: { foreground: "#b9d48f" } },
    { scope: ["entity.name.function", "support.function", "meta.function-call"], settings: { foreground: "#8fb8f0" } },
    { scope: ["constant.numeric", "constant.language", "support.constant"], settings: { foreground: "#f2c66d" } },
    { scope: ["variable.parameter", "support.type.property-name", "meta.object-literal.key"], settings: { foreground: "#e8c9a8" } },
    { scope: ["entity.name.type", "entity.name.class", "support.class"], settings: { foreground: "#f2c66d" } },
    { scope: ["variable.other.constant", "variable.other.readwrite"], settings: { foreground: "#ede4d6" } },
  ],
};
---

<div class="tabs" data-tabs>
  <div class="bar">
    <div class="list" role="tablist" aria-label={label}>
      {tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={`panel-${t.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          {t.label}
        </button>
      ))}
    </div>
  </div>
  {tabs.map((t, i) => (
    <div class="panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0} tabindex="0">
      <div class="meta mono">
        <span>{t.file}</span>
        <span>{t.note}</span>
      </div>
      <Code code={t.code} lang={t.lang} theme={warm as never} />
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
      }
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        const n = tabs.length;
        const to = { ArrowRight: i + 1, ArrowLeft: i - 1 + n, Home: 0, End: n - 1 }[e.key];
        if (to === undefined) return;
        e.preventDefault();
        select(tabs[to % n]!, true);
      });
    });
  });
</script>

<style>
  .tabs {
    min-width: 0;
    background: var(--code-bg);
    color: var(--code-fg);
    border-radius: 14px;
    border: 1px solid var(--code-line);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .bar {
    background: var(--code-bar);
    border-bottom: 1px solid var(--code-line);
    overflow-x: auto;
  }
  .list {
    display: flex;
    gap: 2px;
    padding: 8px 10px 0;
  }
  [role="tab"] {
    position: relative;
    padding: 9px 14px 12px;
    border: 0;
    background: transparent;
    color: var(--code-muted);
    font: 500 13.5px/1 var(--font-sans);
    cursor: pointer;
    white-space: nowrap;
    border-radius: 7px 7px 0 0;
    transition: color 0.15s ease;
  }
  [role="tab"]:hover {
    color: var(--code-fg);
  }
  [role="tab"][aria-selected="true"] {
    color: var(--code-fg);
  }
  [role="tab"][aria-selected="true"]::after {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: -1px;
    height: 2px;
    background: var(--code-key);
    border-radius: 2px;
  }
  [role="tab"]:focus-visible {
    outline-color: var(--code-fn);
    outline-offset: -3px;
  }
  .panel:focus-visible {
    outline: 2px solid var(--code-fn);
    outline-offset: -2px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    padding: 14px 22px 0;
    font-size: 11.5px;
    color: var(--code-muted);
  }
  .panel :global(.astro-code) {
    font-size: 13px;
    padding-top: 12px;
    min-height: 380px;
  }
</style>
