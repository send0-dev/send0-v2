---
// The waitlist form, drawn as a shipping label. Posts to /api/waitlist (D1); works without JavaScript too.
interface Props {
  source: "hero" | "footer-cta" | "pricing";
  id?: string;
}
const { source, id } = Astro.props;
const inputId = `wl-${source}`;
---

<form class="label" method="post" action="/api/waitlist" data-waitlist id={id}>
  <input type="hidden" name="source" value={source} />
  <div class="hp" aria-hidden="true">
    <label>
      Leave this empty <input type="text" name="company" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <div class="sheet">
    <div class="head mono" aria-hidden="true">
      <span>Deliver to</span>
      <span class="code"></span>
    </div>
    <div class="row">
      <label class="sr-only" for={inputId}>
        Your email address
      </label>
      <input
        id={inputId}
        type="email"
        name="email"
        required
        autocomplete="email"
        inputmode="email"
        placeholder="you@company.com"
        maxlength="254"
      />
      <button class="btn btn-primary" type="submit">
        <span class="btn-label">Join the waitlist</span>
        <svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 8h10M9 4l4 4-4 4"></path>
        </svg>
      </button>
    </div>
  </div>
  <!-- Shown after the label folds into an envelope and flies off. The words are announced by .status. -->
  <div class="posted" aria-hidden="true">
    <svg viewBox="0 0 30 21" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M1.5 2.2c9-.6 18-.6 27 .2l-.4 16.6c-9 .5-17.8.4-26.4-.2Z" fill="var(--card)"></path>
      <path d="m1.8 2.6 13 9.4 13.4-9.4"></path>
      <path d="M21.5 5.5h4v4.6h-4Z" fill="var(--accent-bg)" stroke="none"></path>
    </svg>
    <span>
      <strong>Posted.</strong> You're on the list.
    </span>
  </div>
  <p class="status" role="status" aria-live="polite"></p>
</form>

<script>
  const ok = "Thanks. We'll email you once, when send0 launches.";
  document.querySelectorAll<HTMLFormElement>("form[data-waitlist]").forEach((form) => {
    const status = form.querySelector<HTMLElement>(".status")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const label = button.querySelector<HTMLElement>(".btn-label")!;
    const input = form.querySelector<HTMLInputElement>("input[type=email]")!;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (form.dataset.state === "loading") return;
      form.dataset.state = "loading";
      label.textContent = "Joining…";
      status.textContent = "";
      try {
        const res = await fetch(form.action, { method: "POST", headers: { accept: "application/json" }, body: new FormData(form) });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; message?: string };
        if (!res.ok || !data.ok) throw new Error(data.message || "Something went wrong. Try again.");
        form.dataset.state = "done";
        label.textContent = "You're on the list";
        status.textContent = ok;
        input.disabled = button.disabled = true;
      } catch (err) {
        form.dataset.state = "error";
        label.textContent = "Join the waitlist";
        status.textContent = err instanceof Error ? err.message : "Something went wrong. Try again.";
      }
    });
  });

  // No-JS fallback lands on /?waitlist=ok#waitlist
  const result = new URLSearchParams(location.search).get("waitlist");
  const target = document.querySelector<HTMLFormElement>("#waitlist form[data-waitlist]") ?? document.querySelector("form[data-waitlist]");
  if (result && target) {
    target.dataset.state = result === "ok" ? "done" : "error";
    target.querySelector(".status")!.textContent = result === "ok" ? ok : "That email didn't look right. Try again.";
  }
</script>

<style>
  .label {
    position: relative;
    width: 100%;
    max-width: 500px;
    padding: 12px 12px 4px;
    background: var(--card);
    border: 1.5px solid var(--ink);
    border-radius: 12px;
    box-shadow: var(--shadow);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 4px 10px;
    margin-bottom: 10px;
    border-bottom: 1.5px dashed var(--rule);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  /* a small barcode */
  .code {
    width: 74px;
    height: 12px;
    background: repeating-linear-gradient(
      90deg,
      var(--ink) 0 1px,
      transparent 1px 3px,
      var(--ink) 3px 5px,
      transparent 5px 6px,
      var(--ink) 6px 7px,
      transparent 7px 10px
    );
    opacity: 0.75;
  }
  .row {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  input[type="email"] {
    flex: 1;
    min-width: 0;
    height: 46px;
    padding: 0 6px;
    border: 0;
    border-bottom: 1.5px solid var(--rule);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: 400 17px/1 var(--font-sans);
    outline: none;
    transition: border-color 0.15s ease;
  }
  input[type="email"]:focus {
    border-bottom-color: var(--airmail-blue);
  }
  input[type="email"]:focus-visible {
    outline: 2px solid var(--airmail-blue);
    outline-offset: 2px;
    border-radius: 4px;
  }
  input::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  input:disabled {
    opacity: 0.6;
  }
  .row .btn {
    margin-bottom: 3px;
  }
  button:disabled {
    cursor: default;
  }
  .status {
    min-height: 22px;
    padding: 6px 4px 4px;
    font-size: 13.5px;
    color: var(--muted);
  }
  .status:empty {
    min-height: 8px;
    padding: 0;
  }
  .label[data-state="done"] .status {
    color: var(--ok);
  }
  /* Success: the label folds up into a letter and flies off; a small "posted" note takes its place.
     Transform and opacity only, and the form keeps its height, so nothing below moves. */
  .sheet {
    transform-origin: 50% 0;
  }
  .posted {
    position: absolute;
    inset: 12px 12px 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 15.5px;
    color: var(--ink);
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
  }
  .posted svg {
    width: 34px;
    color: var(--ink);
  }
  .label[data-state="done"] .sheet {
    animation: fold-fly 0.95s cubic-bezier(0.5, 0, 0.3, 1) forwards;
    pointer-events: none;
  }
  .label[data-state="done"] .posted {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.4s ease 0.8s,
      transform 0.5s var(--ease-out) 0.8s;
  }
  @keyframes fold-fly {
    0% {
      transform: none;
    }
    30% {
      transform: perspective(700px) rotateX(62deg) scale(0.9);
      opacity: 1;
    }
    55% {
      transform: perspective(700px) rotateX(0deg) scale(0.32, 0.5) rotate(-4deg);
      opacity: 1;
    }
    100% {
      transform: translate(46%, -150%) scale(0.12) rotate(-22deg);
      opacity: 0;
    }
  }
  .label[data-state="error"] .status {
    color: var(--accent);
  }
  @media (max-width: 479px) {
    .row {
      flex-direction: column;
      align-items: stretch;
    }
    .row .btn {
      margin-top: 8px;
      margin-bottom: 4px;
    }
  }
</style>
