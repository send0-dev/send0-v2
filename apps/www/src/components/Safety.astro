---
import { site } from "../site";

const outbound = [
  {
    title: "Free accounts are reply-only",
    body: "They can send only to people who emailed the inbox first, plus the account owner. No one gets mail from send0 they didn't start.",
  },
  {
    title: "Real accounts, gradual limits",
    body: "Every account verifies its email address, and throwaway addresses are refused. New accounts start at 50 sends a day, and the limit rises with a clean record.",
  },
  {
    title: "Automatic pause",
    body: "Sending stops on its own if complaints pass 0.3% or hard bounces pass 5%, and the account owner gets an inbox.suspended event.",
  },
  {
    title: "No cold outreach, no bulk mail",
    body: "Unsolicited outreach, newsletters and marketing blasts are banned. Higher volume requires a verified custom domain.",
  },
  {
    title: "Suppression built in",
    body: "Addresses that bounce or complain are suppressed automatically, so the same mistake never happens twice.",
  },
  {
    title: "Watched role addresses",
    body: "postmaster, abuse, security and similar names are reserved and read by a person. Reports get answered.",
  },
];

const inbound = [
  "SPF, DKIM and DMARC results on every message",
  "Drop mail that fails authentication, per inbox",
  "Prompt-injection flag, with message bodies passed to models as data rather than instructions",
  "Allowlists and blocklists per inbox",
  "Approval mode, so a person signs off on outgoing mail",
];
---

<section class="section" id="safety" aria-labelledby="safety-title">
  <div class="section-head reveal">
    <span class="eyebrow">Trust and safety</span>
    <h2 id="safety-title" class="h2">
      Built so good mail keeps landing. <span class="dim">For everyone.</span>
    </h2>
    <p class="lede">
      A shared sending domain only works if no one abuses it. These controls are on from the first day, on every account, and they're
      written into our <a href="/acceptable-use">acceptable use policy</a>.
    </p>
  </div>

  <div class="layout">
    <div class="grid">
      {outbound.map((o) => (
        <article class="item reveal">
          <h3>{o.title}</h3>
          <p>{o.body}</p>
        </article>
      ))}
    </div>

    <aside class="panel reveal">
      <span class="mono label">Protecting your agent</span>
      <h3>Inbound mail is untrusted input. send0 treats it that way.</h3>
      <ul>
        {inbound.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
      <p class="report">
        See something wrong? Write to <a href={`mailto:${site.email.abuse}`}>{site.email.abuse}</a>. A person reads every report.
      </p>
    </aside>
  </div>
</section>

<style>
  .lede a,
  .report a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }
  .lede a:hover,
  .report a:hover {
    text-decoration-color: var(--accent);
  }
  .layout {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: 1.5fr 1fr;
    }
  }
  .grid {
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .item {
    padding: 24px;
    background: var(--surface);
  }
  .item h3 {
    font-size: 16px;
    letter-spacing: -0.01em;
  }
  .item p {
    margin-top: 8px;
    font-size: 14.5px;
    color: var(--fg-muted);
  }
  /* Always a dark card, in both themes */
  .panel {
    --p-bg: #0c0c0d;
    --p-fg: #f4f4f5;
    --p-muted: #b4b4bb;
    --p-faint: #8a8a92;
    --p-line: #ffffff1f;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    border-radius: var(--radius);
    border: 1px solid var(--p-line);
    background: var(--p-bg);
    color: var(--p-fg);
  }
  .panel .label {
    font-size: 12px;
    color: #ff6a26;
  }
  .panel h3 {
    font-size: 21px;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .panel ul {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .panel li {
    position: relative;
    padding-left: 24px;
    font-size: 14.5px;
    color: var(--p-muted);
  }
  .panel li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 7px;
    width: 10px;
    height: 6px;
    border-left: 1.6px solid #ff6a26;
    border-bottom: 1.6px solid #ff6a26;
    transform: rotate(-45deg);
  }
  .report {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--p-line);
    font-size: 13.5px;
    color: var(--p-faint);
  }
  .report a {
    color: var(--p-fg);
    text-decoration-color: #ffffff55;
  }
</style>
