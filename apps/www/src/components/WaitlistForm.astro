---
// The waitlist: an email field joined to the button. Posts to /api/waitlist (D1) and works without JavaScript.
// Renders the form and its status line as siblings, so the status can wrap onto its own row under the CTAs.
---

<form class="wl" method="post" action="/api/waitlist" aria-describedby="wl-status" data-waitlist>
  <input type="hidden" name="source" value="hero" />
  <div class="hp" aria-hidden="true">
    <label>
      Company <input type="text" name="company" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <label class="sr-only" for="wl-email">
    Your email address
  </label>
  <input
    id="wl-email"
    type="email"
    name="email"
    required
    autocomplete="email"
    inputmode="email"
    placeholder="you@company.com"
    maxlength="254"
  />
  <button class="btn solid" type="submit">
    Join the waitlist
  </button>
</form>
<p class="wl-status" id="wl-status" role="status" aria-live="polite"></p>

<script>
  const OK = "[✓] You're on the list. We'll email you once, when send0 launches.";
  const form = document.querySelector<HTMLFormElement>("form[data-waitlist]");
  const status = document.getElementById("wl-status");
  if (form && status) {
    const button = form.querySelector("button")!;
    const input = form.querySelector<HTMLInputElement>("input[type=email]")!;
    const say = (tone: "ok" | "error" | "", text: string) => {
      status.dataset.tone = tone;
      status.textContent = text;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (form.dataset.state === "loading") return;
      form.dataset.state = "loading";
      button.textContent = "Joining…";
      say("", "");
      try {
        const res = await fetch(form.action, { method: "POST", headers: { accept: "application/json" }, body: new FormData(form) });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; message?: string };
        if (!res.ok || !data.ok) throw new Error(data.message || "Something went wrong. Try again.");
        form.dataset.state = "done";
        button.textContent = "Joined ✓";
        input.disabled = button.disabled = true;
        say("ok", OK);
      } catch (err) {
        form.dataset.state = "error";
        button.textContent = "Join the waitlist";
        say("error", err instanceof Error ? err.message : "Something went wrong. Try again.");
        input.focus();
      }
    });

    // Every "Join waitlist" link lands here; put the cursor in the field once the page has scrolled.
    document.addEventListener("click", (e) => {
      const link = (e.target as Element).closest?.('a[href="/#join"], a[href="#join"]');
      if (link && location.pathname === "/") setTimeout(() => input.focus({ preventScroll: true }), 0);
    });

    // The no-JS fallback lands on /?waitlist=ok#join.
    const result = new URLSearchParams(location.search).get("waitlist");
    if (result) {
      form.dataset.state = result === "ok" ? "done" : "error";
      say(result === "ok" ? "ok" : "error", result === "ok" ? OK : "That email didn't look right. Try again.");
    }
  }
</script>
