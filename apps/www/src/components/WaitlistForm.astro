---
interface Props {
  source: string;
}
const { source } = Astro.props;
const id = `wl-${source}`;
---

<form class="wl" method="post" action="/api/waitlist" data-waitlist>
  <input type="hidden" name="source" value={source} />
  <div class="hp" aria-hidden="true">
    <label>
      Leave this empty <input type="text" name="company" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <label class="sr-only" for={id}>
    Work email
  </label>
  <div class="field">
    <input
      id={id}
      type="email"
      name="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="you@company.com"
      maxlength="254"
    />
    <button class="btn btn-accent" type="submit">
      <span class="label">Join the waitlist</span>
      <svg
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 8h10M9 4l4 4-4 4"></path>
      </svg>
    </button>
  </div>
  <p class="status" role="status" aria-live="polite"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("form[data-waitlist]").forEach((form) => {
    const status = form.querySelector<HTMLElement>(".status")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const label = button.querySelector<HTMLElement>(".label")!;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (form.dataset.state === "loading") return;
      form.dataset.state = "loading";
      label.textContent = "Joining…";
      status.textContent = "";

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { accept: "application/json" },
          body: new FormData(form),
        });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; message?: string };
        if (!res.ok || !data.ok) throw new Error(data.message || "Something went wrong. Try again.");
        form.dataset.state = "done";
        label.textContent = "You're on the list";
        status.textContent = data.message ?? "Thanks. We'll email you when the beta opens.";
        form.querySelector<HTMLInputElement>("input[type=email]")!.disabled = true;
        button.disabled = true;
      } catch (err) {
        form.dataset.state = "error";
        label.textContent = "Join the waitlist";
        status.textContent = err instanceof Error ? err.message : "Something went wrong. Try again.";
      }
    });
  });

  const params = new URLSearchParams(location.search);
  const result = params.get("waitlist");
  if (result) {
    const form =
      document.querySelector<HTMLFormElement>("#waitlist form[data-waitlist]") ??
      document.querySelector<HTMLFormElement>("form[data-waitlist]");
    const status = form?.querySelector<HTMLElement>(".status");
    if (form && status) {
      form.dataset.state = result === "ok" ? "done" : "error";
      status.textContent = result === "ok" ? "Thanks. We'll email you when the beta opens." : "That email didn't look right. Try again.";
    }
  }
</script>

<style>
  .wl {
    width: 100%;
    max-width: 460px;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .field {
    display: flex;
    gap: 6px;
    padding: 5px;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .field:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  input[type="email"] {
    flex: 1;
    min-width: 0;
    height: 42px;
    padding: 0 10px;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: 400 16px/1 var(--font-sans);
    outline: none;
  }
  input::placeholder {
    color: var(--fg-faint);
  }
  input:disabled {
    opacity: 0.6;
  }
  button:disabled {
    cursor: default;
  }
  .status {
    min-height: 22px;
    margin-top: 10px;
    font-size: 14px;
    color: var(--fg-muted);
  }
  .wl[data-state="done"] .status {
    color: var(--ok);
  }
  .wl[data-state="done"] .btn {
    background: var(--ok);
  }
  .wl[data-state="error"] .status {
    color: var(--accent-ink);
  }
  @media (max-width: 479px) {
    .field {
      flex-direction: column;
    }
    .field .btn {
      width: 100%;
    }
  }
</style>
