---
type Cell = true | false | string;

const cols = ["send0", "Hosted inbox APIs", "Transactional email APIs", "Running your own mail server"];

const rows: { label: string; cells: Cell[] }[] = [
  {
    label: "Create inboxes through an API",
    cells: [true, true, false, "Scripts and config"],
  },
  {
    label: "Receive mail and keep threads",
    cells: [true, true, "Inbound hooks only", "You build it"],
  },
  {
    label: "Webhooks and real-time on the free plan",
    cells: [true, "Varies by plan", true, "You build it"],
  },
  { label: "Code and link extraction", cells: [true, "Varies", false, false] },
  { label: "Prompt-injection flag", cells: [true, "Varies", false, false] },
  {
    label: "API keys scoped to one inbox",
    cells: [true, "Varies", false, false],
  },
  { label: "Open source", cells: [true, false, false, "Usually"] },
  { label: "Run it on your own servers", cells: [true, false, false, true] },
  {
    label: "Time to a working inbox",
    cells: ["Minutes", "Minutes", "Hours", "Days"],
  },
];
---

<section class="section" aria-labelledby="compare-title">
  <div class="section-head reveal">
    <span class="eyebrow">Compare</span>
    <h2 id="compare-title" class="h2">
      Inbox-first. <span class="dim">Not sending with inbound bolted on.</span>
    </h2>
    <p class="lede">
      Transactional email APIs are built to send receipts. Your own mail server is built for people. send0 is built for software that needs
      to hold a conversation.
    </p>
  </div>

  <div class="wrap reveal">
    <table>
      <caption class="sr-only">send0 compared with other ways to give agents email</caption>
      <thead>
        <tr>
          <th scope="col">
            <span class="sr-only">Capability</span>
          </th>
          {cols.map((c, i) => (
            <th scope="col" class={i === 0 ? "us" : ""}>
              {c}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            {r.cells.map((c, i) => (
              <td class={i === 0 ? "us" : ""}>
                {c === true ? (
                  <span class="yes" aria-label="Yes">
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m3.5 8.5 3 3 6-7" />
                    </svg>
                  </span>
                ) : c === false ? (
                  <span class="no" aria-label="No">
                    —
                  </span>
                ) : (
                  <span class="txt">{c}</span>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .wrap {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow-x: auto;
  }
  table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  th,
  td {
    padding: 14px 18px;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--fg-muted);
    vertical-align: bottom;
  }
  thead th.us {
    color: var(--fg);
  }
  tbody th {
    font-weight: 500;
    color: var(--fg);
    width: 30%;
  }
  .us {
    background: color-mix(in srgb, var(--accent-soft) 55%, transparent);
  }
  .yes {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--fg);
    color: var(--bg);
  }
  td.us .yes {
    background: var(--accent);
    color: var(--accent-fg);
  }
  .yes svg {
    width: 13px;
    height: 13px;
  }
  .no {
    color: var(--fg-faint);
  }
  .txt {
    font-size: 13.5px;
    color: var(--fg-muted);
  }
  td.us .txt {
    color: var(--fg);
    font-weight: 500;
  }
</style>
