{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "send0-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.send0.dev", "custom_domain": true }],
  // Postgres (Neon) through Hyperdrive. Create with: wrangler hyperdrive create send0-db --connection-string=...
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "d4b5efae692848d08e04fa2dd1bab031" }],
  // Real-time hubs: one per inbox and one per org (SQLite-backed, available on the free plan).
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // Webhook fan-out and delivery attempts, including delayed retries.
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "send0-events" }],
    "consumers": [{ "queue": "send0-events", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 10 }],
  },
  // Request limits per 60 s (keep in step with RATE_LIMITS in src/rate-limit.ts). namespace_id is any
  // number unique within the Cloudflare account. If a binding is missing, that rule falls back to
  // per-isolate counters.
  "ratelimits": [
    // Every request made with an API key (or by a dashboard user)
    { "name": "RL_KEY", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    // On top of that, requests that send mail: send, reply, forward, approve a draft
    { "name": "RL_KEY_SEND", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    // Per client IP: failed authentication and signed download links
    { "name": "RL_IP", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
  ],
  // Outbox safety net. Hourly, so Neon's free compute can still scale to zero.
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "MAIL_DOMAINS": "send0.email",
    "S3_BUCKET": "send0-raw-mail-aps1",
    "S3_REGION": "ap-south-1",
    "SES_REGION": "ap-south-1",
    "SES_CONFIGURATION_SET": "send0-default",
    "SES_EVENTS_TOPIC_ARN": "arn:aws:sns:ap-south-1:366112400292:send0-ses-events",
    // Secrets (wrangler secret put):
    //   S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY  (read-only S3 user)
    //   SES_ACCESS_KEY_ID, SES_SECRET_ACCESS_KEY (send-only SES user)
    //   SES_EVENTS_TOKEN                          (secret in the SNS subscription URL)
  },
  // Run next to the database (Neon, AWS Singapore): one long hop per request instead of one per query.
  "placement": { "mode": "targeted", "region": "aws:ap-southeast-1" },
  "observability": { "enabled": true },
}
